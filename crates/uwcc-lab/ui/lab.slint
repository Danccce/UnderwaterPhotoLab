import { Button, CheckBox, ComboBox, LineEdit, Palette, ScrollView } from "std-widgets.slint";

export struct Thumb {
    image: image,
    name: string,
    loaded: bool,
    failed: bool,
    edited: bool,
    exported: bool,
    selected: bool,
    // Vorschaubild der exportierten Datei
    corrected: image,
    has-corrected: bool,
    // Platz in der gefilterten Leiste; −1 = ausgeblendet.
    slot: int,
}

struct HelpSection {
    title: string,
    lines: [string],
}

export struct ProgramItem {
    name: string,
    found: bool,
    chosen: bool,
}

// Ein ausgebesserter Partikel im Ergebnis (Pixel der vollen Auflösung).
export struct SpotMark {
    x: float,
    y: float,
    r: float,
}

export struct PresetItem {
    name: string,
    builtin: bool,
}

export struct InfoRow {
    label: string,
    value: string,
}

// Eigener Regler statt `Slider`, weil dessen Doppelklick nicht abzufangen ist.
component ValueSlider inherits Rectangle {
    in property <float> minimum;
    in property <float> maximum;
    in-out property <float> value;
    in property <bool> enabled: true;
    callback changed(float);
    callback released();
    callback double-clicked();
    height: 22px;

    property <length> knob: 16px;
    property <float> fraction: clamp((root.value - root.minimum) / (root.maximum - root.minimum), 0, 1);
    property <brush> accent: root.enabled ? Palette.accent-background : #5a5d65;

    function set-from(x: length) {
        root.value = clamp(root.minimum + (x - root.knob / 2) / (root.width - root.knob) * (root.maximum - root.minimum), root.minimum, root.maximum);
        root.changed(root.value);
    }

    Rectangle {
        y: (root.height - 4px) / 2;
        height: 4px;
        border-radius: 2px;
        background: #4a4d55;
    }
    Rectangle {
        x: 0;
        y: (root.height - 4px) / 2;
        width: (root.width - root.knob) * root.fraction + root.knob / 2;
        height: 4px;
        border-radius: 2px;
        background: root.accent;
    }
    Rectangle {
        x: (root.width - root.knob) * root.fraction;
        y: (root.height - root.knob) / 2;
        width: root.knob;
        height: root.knob;
        border-radius: root.knob / 2;
        background: root.accent;
        border-width: 2px;
        border-color: #1e1f22;
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.set-from(self.mouse-x);
            }
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                root.released();
            }
        }
        moved => {
            if self.pressed {
                root.set-from(self.mouse-x);
            }
        }
        double-clicked => {
            root.double-clicked();
        }
    }
}

component SliderRow inherits VerticalLayout {
    in property <string> label;
    in property <string> text;
    in property <string> field;
    in-out property <float> value;
    in property <float> minimum;
    in property <float> maximum;
    in property <bool> enabled: true;
    callback edited(string, float);
    callback reset(string);
    callback released();
    spacing: 0px;
    // Sonst wächst die Zeile in einer festen Spalte mit und Beschriftung und Regler rücken auseinander.
    vertical-stretch: 0;

    HorizontalLayout {
        Text {
            text: root.label;
            font-size: 12px;
            color: root.enabled ? Palette.foreground : #6b7078;
        }
        Text {
            text: root.text;
            font-size: 12px;
            horizontal-alignment: right;
            color: root.enabled ? #c8ccd2 : #6b7078;
        }
    }
    ValueSlider {
        minimum: root.minimum;
        maximum: root.maximum;
        value <=> root.value;
        enabled: root.enabled;
        changed(v) => {
            root.edited(root.field, v);
        }
        released => {
            root.released();
        }
        double-clicked => {
            root.reset(root.field);
        }
    }
}

// Umschalter aus gleich breiten Teilen: der gewählte ist in der Markierungsfarbe hinterlegt.
// Markierungsfarbe überall: Palette.accent-background, wie bei Reglern, Checkbox und Hauptknopf.
component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> selected;
    callback changed(int);
    height: 26px;
    border-radius: 5px;
    border-width: 1px;
    border-color: #5a5d65;
    background: #2b2d31;
    clip: true;

    HorizontalLayout {
        for option[i] in root.options: Rectangle {
            horizontal-stretch: 1;
            background: i == root.selected ? Palette.accent-background : touch.has-hover ? #ffffff14 : transparent;
            if i > 0: Rectangle {
                x: 0;
                width: 1px;
                background: #5a5d65;
            }
            Text {
                text: option;
                font-size: 12px;
                color: i == root.selected ? Palette.accent-foreground : Palette.foreground;
            }
            touch := TouchArea {
                clicked => {
                    if i != root.selected {
                        root.changed(i);
                    }
                }
            }
        }
    }
}

// Beschnitt-Dreieck in einer Ecke des Histogramms; gefüllt, wenn Kanäle beschnitten sind.
component ClipTriangle inherits TouchArea {
    in property <bool> right;
    in property <color> clipped;
    in property <bool> warning;
    width: 22px;
    height: 22px;
    mouse-cursor: MouseCursor.pointer;
    Path {
        x: root.right ? root.width - 16px : 4px;
        y: 4px;
        width: 12px;
        height: 12px;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: root.right ? "M 0 0 L 12 0 L 12 12 Z" : "M 0 0 L 12 0 L 0 12 Z";
        fill: root.clipped.alpha > 0 ? root.clipped : #ffffff22;
        stroke: root.warning ? white : #00000000;
        stroke-width: root.warning ? 1.5px : 0px;
    }
}

component Histogram inherits Rectangle {
    in property <string> red;
    in property <string> green;
    in property <string> blue;
    in property <color> clip-shadows;
    in property <color> clip-highlights;
    in property <bool> warning;
    callback toggled();
    border-radius: 4px;
    background: #18191c;
    clip: true;

    if root.red != "": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 256;
        viewbox-height: 100;
        commands: root.red;
        fill: #ff4a4a80;
        stroke-width: 0px;
    }
    if root.green != "": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 256;
        viewbox-height: 100;
        commands: root.green;
        fill: #45d16480;
        stroke-width: 0px;
    }
    if root.blue != "": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 256;
        viewbox-height: 100;
        commands: root.blue;
        fill: #4a8cff80;
        stroke-width: 0px;
    }
    ClipTriangle {
        x: 0;
        y: 0;
        clipped: root.clip-shadows;
        warning: root.warning;
        clicked => {
            root.toggled();
        }
    }
    ClipTriangle {
        x: root.width - self.width;
        y: 0;
        right: true;
        clipped: root.clip-highlights;
        warning: root.warning;
        clicked => {
            root.toggled();
        }
    }
}

// Kleiner Knopf mit selbst gezeichnetem Symbol (Pfad im Raster 16 × 16, nur Linien).
component IconButton inherits Rectangle {
    in property <string> commands;
    in property <bool> enabled: true;
    callback clicked();
    width: 32px;
    border-radius: 4px;
    background: touch.has-hover && root.enabled ? #ffffff26 : #ffffff12;
    Path {
        x: (parent.width - 16px) / 2;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: root.commands;
        stroke: root.enabled ? #c8ccd2 : #5a5d65;
        stroke-width: 1.6px;
        fill: transparent;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            root.clicked();
        }
    }
}

// Flacher Knopf für die Leiste unter dem Bild; in der Markierungsfarbe wie der Umschalter, wenn `active`.
component SmallButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <bool> enabled: true;
    out property <bool> pressed: touch.pressed;
    callback clicked();
    height: 24px;
    width: label.preferred-width + 20px;
    border-radius: 4px;
    background: root.active ? Palette.accent-background : touch.has-hover && root.enabled ? #ffffff26 : #ffffff12;
    label := Text {
        text: root.text;
        font-size: 12px;
        color: root.active ? Palette.accent-foreground : root.enabled ? Palette.foreground : #6b7078;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// Quadratischer Symbolknopf der Werkzeugspalte (Pfad im Raster 20 × 20, nur Linien); meldet das
// Darüberfahren mit der Mitte in Fensterkoordinaten, damit das Fenster einen Hinweis zeigen kann.
component ToolButton inherits Rectangle {
    in property <string> commands;
    in property <bool> active;
    in property <bool> enabled: true;
    out property <bool> pressed: touch.pressed;
    out property <bool> hovered: touch.has-hover;
    callback clicked();
    callback hover(bool, length);
    width: 36px;
    height: 36px;
    border-radius: 6px;
    background: root.active ? Palette.accent-background : touch.has-hover && root.enabled ? #ffffff1f : transparent;
    changed hovered => {
        root.hover(self.hovered, self.absolute-position.y + self.height / 2);
    }
    Path {
        x: (parent.width - 20px) / 2;
        y: (parent.height - 20px) / 2;
        width: 20px;
        height: 20px;
        viewbox-width: 20;
        viewbox-height: 20;
        commands: root.commands;
        stroke: root.active ? Palette.accent-foreground : root.enabled ? #d4d7dc : #5a5d65;
        stroke-width: 1.6px;
        fill: transparent;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            root.clicked();
        }
    }
}

// Runder „?“-Knopf für die Hilfe.
component HelpButton inherits Rectangle {
    callback clicked();
    width: 26px;
    height: 26px;
    border-radius: 13px;
    border-width: 1px;
    border-color: #5a5d65;
    background: touch.has-hover ? #ffffff26 : #ffffff10;
    Text {
        text: "?";
        font-weight: 700;
    }
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Waagerechter Scrollbalken, immer sichtbar (der eingebaute erscheint erst beim Darüberfahren):
// Griff ziehen oder in die Spur klicken, dann springt der Griff mittig an die Stelle.
component HScrollbar inherits Rectangle {
    in property <length> content-width;
    in property <length> visible-width;
    in-out property <length> content-x;
    property <length> range: max(0px, root.content-width - root.visible-width);
    property <length> thumb-width: max(40px, root.width * root.visible-width / max(1px, root.content-width));
    property <length> travel: max(1px, root.width - root.thumb-width);
    property <length> thumb-x: root.range > 0 ? -root.content-x / root.range * root.travel : 0px;
    // Abstand des Mauszeigers vom Anfang des Griffs beim Ziehen.
    property <length> grab;
    visible: root.range > 0;
    border-radius: 5px;
    background: #ffffff10;

    function scroll-to(thumb-left: length) {
        root.content-x = -clamp(thumb-left, 0px, root.travel) / root.travel * root.range;
    }

    Rectangle {
        x: root.thumb-x;
        width: root.thumb-width;
        border-radius: 5px;
        background: touch.pressed ? Palette.accent-background : touch.has-hover ? #ffffff60 : #ffffff38;
    }
    touch := TouchArea {
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                if self.mouse-x >= root.thumb-x && self.mouse-x <= root.thumb-x + root.thumb-width {
                    root.grab = self.mouse-x - root.thumb-x;
                } else {
                    root.grab = root.thumb-width / 2;
                    root.scroll-to(self.mouse-x - root.grab);
                }
            }
        }
        moved => {
            if self.pressed {
                root.scroll-to(self.mouse-x - root.grab);
            }
        }
    }
}

component Heading inherits Text {
    font-weight: 700;
    font-size: 13px;
}

component Tag inherits Rectangle {
    in property <string> text;
    height: 24px;
    width: label.preferred-width + 16px;
    border-radius: 4px;
    background: #000000a0;
    label := Text {
        text: root.text;
        color: white;
        font-size: 12px;
    }
}

export component LabWindow inherits Window {
    title: "UnderwaterPhotoLab";
    icon: @image-url("../../../assets/icon-256.png");
    preferred-width: 1200px;
    preferred-height: 780px;
    min-width: 960px;
    min-height: 620px;
    forward-focus: keys;
    // Aussehen wie RapidRaw: dunkler Grund, darauf abgerundete Flächen mit Abstand.
    background: #0f1012;
    property <color> panel-color: #1c1d21;

    in property <[Thumb]> thumbs;
    in-out property <int> current: -1;
    in property <string> folder;
    property <string> status;
    // Bildinformationen: in der Leiste die Zusammenfassung, im Fenster am Dateinamen alle Zeilen.
    in property <string> info-title;
    in property <string> info-summary;
    in property <[InfoRow]> info-rows;
    in property <bool> drag-over;
    in property <image> preview-original;
    in property <image> preview-corrected;
    in property <bool> has-preview;
    in property <bool> loading;
    in-out property <bool> split;
    in-out property <float> split-pos: 0.5;

    // Histogramm der korrigierten Vorschau: SVG-Pfade im Raster 256 × 100 aus Rust.
    in property <string> hist-red;
    in property <string> hist-green;
    in property <string> hist-blue;
    // Farbe der Beschnitt-Dreiecke; durchsichtig, wenn nichts beschnitten ist.
    in property <color> clip-shadows;
    in property <color> clip-highlights;
    // Taste J oder Klick auf ein Dreieck: beschnittene Stellen im Bild markieren.
    in-out property <bool> clip-warning;
    callback clip-warning-changed();

    // Zoom: Doppelklick oder Z auf 100 %, Mausrad oder Pinch stufenlos. Rust rechnet den Ausschnitt
    // `zoom-x/-y/-w/-h` (Bildpixel) des ganzen Bildes; `zoom-cx/-cy` ist die gewünschte Mitte in
    // Bildpixeln, `zoom-scale` sind Bildschirmpixel je Bildpixel (1 = 100 %).
    in-out property <bool> zoomed;
    in-out property <float> zoom-scale: 1;
    in-out property <float> zoom-cx;
    in-out property <float> zoom-cy;
    in property <float> full-width: 1;
    in property <float> full-height: 1;
    in property <image> zoom-original;
    in property <image> zoom-corrected;
    in property <float> zoom-x;
    in property <float> zoom-y;
    in property <float> zoom-w;
    in property <float> zoom-h;
    // Setzt Rust bei jedem Scrollen: Touchpad schiebt, Mausrad zoomt.
    in property <bool> wheel-from-touchpad;
    out property <float> view-w: preview-box.width / 1phx;
    out property <float> view-h: preview-box.height / 1phx;
    callback zoom-changed();
    property <length> fit: min(preview-box.width / root.full-width, preview-box.height / root.full-height);
    property <float> fit-scale: root.fit / 1phx;
    property <float> max-scale: 4;
    // Bildstelle unter dem Mauszeiger, die beim Zoomen stehen bleibt.
    property <float> anchor-x;
    property <float> anchor-y;

    // Hält die Mitte so, dass der Ausschnitt im Bild bleibt; kleinere Bilder stehen mittig.
    public function set-center(x: float, y: float) {
        root.zoom-cx = root.full-width * root.zoom-scale <= root.view-w ? root.full-width / 2
            : clamp(x, root.view-w / 2 / root.zoom-scale, root.full-width - root.view-w / 2 / root.zoom-scale);
        root.zoom-cy = root.full-height * root.zoom-scale <= root.view-h ? root.full-height / 2
            : clamp(y, root.view-h / 2 / root.zoom-scale, root.full-height - root.view-h / 2 / root.zoom-scale);
    }
    // Mausposition im Vorschaufeld → Bildpixel, in beiden Ansichten.
    pure function image-x(mx: length) -> float {
        root.zoomed ? root.zoom-cx + (mx - preview-box.width / 2) / 1phx / root.zoom-scale
            : (mx - (preview-box.width - root.full-width * root.fit) / 2) / root.fit
    }
    pure function image-y(my: length) -> float {
        root.zoomed ? root.zoom-cy + (my - preview-box.height / 2) / 1phx / root.zoom-scale
            : (my - (preview-box.height - root.full-height * root.fit) / 2) / root.fit
    }
    // Zuschneiden (Taste C): die Vorschau zeigt den ganzen gedrehten Rahmen, darüber den Zuschnitt
    // als Anteile 0–1 des Rahmens. Gezogen wird hier; beim Loslassen geht er an Rust.
    in-out property <bool> cropping;
    callback cropping-changed();
    in property <float> frame-width: 1;
    in property <float> frame-height: 1;
    in-out property <float> crop-x;
    in-out property <float> crop-y;
    in-out property <float> crop-w: 1;
    in-out property <float> crop-h: 1;
    callback crop-changed(float, float, float, float);
    // Seitenverhältnis: 0 frei, 1 wie Original, 2 3:2, 3 4:3, 4 1:1, 5 16:9, 6 4:5.
    in-out property <int> crop-ratio;
    in-out property <bool> crop-portrait;
    in-out property <float> v-straighten;
    property <bool> line-tool;
    callback rotate(bool);
    callback flip();
    callback reset-geometry();
    property <float> ratio-base: root.crop-ratio == 1 ? root.frame-width / root.frame-height
        : root.crop-ratio == 2 ? 3 / 2 : root.crop-ratio == 3 ? 4 / 3 : root.crop-ratio == 5 ? 16 / 9
        : root.crop-ratio == 6 ? 4 / 5 : 1;
    // Breite durch Höhe in Pixeln.
    property <float> ratio: root.crop-portrait ? 1 / root.ratio-base : root.ratio-base;

    function set-cropping(on: bool) {
        root.cropping = on;
        root.healing = false;
        root.zoomed = false;
        root.line-tool = false;
        root.cropping-changed();
    }

    // Partikel entfernen (Taste P): Klick setzt einen Partikel, Klick auf einen Kreis nimmt ihn weg.
    in-out property <bool> healing;
    // Durchmesser des nächsten Partikels in Pixeln des Ergebnisses (volle Auflösung).
    in-out property <float> heal-size: 24;
    in property <[SpotMark]> spot-marks;
    callback heal-click(float, float);
    callback clear-spots();
    function set-healing(on: bool) {
        if on && root.cropping {
            root.set-cropping(false);
        }
        root.healing = on;
    }

    // Übersicht (Startseite, Taste G): alle angezeigten Bilder als Raster; Doppelklick oder Enter
    // öffnet das gewählte zum Bearbeiten, der Pfeil oben links führt zurück. Die Zellen füllen die
    // Breite, mindestens `grid-size` (Regler „Bildgröße“, wird in config.json gemerkt).
    in-out property <bool> library: true;
    in-out property <float> grid-size: 190;
    callback grid-size-changed(float);
    property <length> grid-min-width: root.grid-size * 1px;
    property <int> grid-cols: max(1, floor((grid.visible-width - root.cell-gap) / (root.grid-min-width + root.cell-gap)));
    property <length> grid-cell-width: (grid.visible-width - root.cell-gap * (root.grid-cols + 1)) / root.grid-cols;
    property <length> grid-cell-height: root.grid-cell-width;
    // Hinweis neben der Werkzeugspalte für das Symbol unter dem Mauszeiger.
    property <string> tip;
    property <length> tip-y;
    function show-tip(on: bool, text: string, y: length) {
        if on {
            root.tip = text;
            root.tip-y = y;
        } else if root.tip == text {
            root.tip = "";
        }
    }
    function set-library(on: bool) {
        if on {
            root.set-cropping(false);
            root.healing = false;
            root.before-pressed = false;
        }
        root.library = on;
    }
    function show-current-in-grid() {
        if root.current-slot >= 0 {
            let top = root.cell-gap + floor(root.current-slot / root.grid-cols) * (root.grid-cell-height + root.cell-gap);
            if top + grid.content-y < 0 {
                grid.content-y = root.cell-gap - top;
            } else if top + root.grid-cell-height + grid.content-y > grid.visible-height {
                grid.content-y = grid.visible-height - top - root.grid-cell-height - root.cell-gap;
            }
        }
    }
    changed library => {
        root.show-current-in-grid();
    }
    // Bildpixel (Ergebnis) → Bildschirm, in beiden Ansichten (Umkehrung von image-x/-y).
    pure function screen-x(px: float) -> length {
        root.zoomed ? preview-box.width / 2 + (px - root.zoom-cx) * root.zoom-scale * 1phx
            : (preview-box.width - root.full-width * root.fit) / 2 + px * root.fit
    }
    pure function screen-y(py: float) -> length {
        root.zoomed ? preview-box.height / 2 + (py - root.zoom-cy) * root.zoom-scale * 1phx
            : (preview-box.height - root.full-height * root.fit) / 2 + py * root.fit
    }
    pure function screen-len(px: float) -> length {
        root.zoomed ? px * root.zoom-scale * 1phx : px * root.fit
    }
    // Größter Zuschnitt im gewählten Verhältnis, um die bisherige Mitte.
    function apply-ratio() {
        if root.crop-ratio != 0 {
            let k = root.frame-width / root.frame-height / root.ratio;
            let w = k > 1 ? 1 / k : 1;
            let h = w * k;
            let cx = root.crop-x + root.crop-w / 2;
            let cy = root.crop-y + root.crop-h / 2;
            root.crop-x = clamp(cx - w / 2, 0, 1 - w);
            root.crop-y = clamp(cy - h / 2, 0, 1 - h);
            root.crop-w = w;
            root.crop-h = h;
            root.crop-changed(root.crop-x, root.crop-y, root.crop-w, root.crop-h);
        }
    }

    // Während des Ladens ist die Bildgröße noch unbekannt; dann zentriert Rust nach dem Laden.
    in-out property <bool> center-on-load;
    // Zoomt auf `scale`, die Bildstelle unter (mx, my) bleibt stehen; bis zum eingepassten Bild
    // zurück beendet den Zoom.
    function zoom-to(scale: float, mx: length, my: length) {
        if root.loading {
            root.center-on-load = true;
            root.zoom-scale = min(scale, root.max-scale);
            root.zoomed = true;
            root.zoom-changed();
        } else if scale <= root.fit-scale * 1.01 {
            root.zoomed = false;
        } else {
            root.anchor-x = root.image-x(mx);
            root.anchor-y = root.image-y(my);
            root.zoom-scale = min(scale, root.max-scale);
            root.zoomed = true;
            root.set-center(root.anchor-x - (mx - preview-box.width / 2) / 1phx / root.zoom-scale,
                root.anchor-y - (my - preview-box.height / 2) / 1phx / root.zoom-scale);
            root.zoom-changed();
        }
    }
    changed view-w => {
        if root.zoomed {
            root.set-center(root.zoom-cx, root.zoom-cy);
            root.zoom-changed();
        }
    }
    changed view-h => {
        if root.zoomed {
            root.set-center(root.zoom-cx, root.zoom-cy);
            root.zoom-changed();
        }
    }

    callback open-folder();
    // Klick in der Leiste: Index, Strg gedrückt, Umschalt gedrückt.
    callback thumb-pressed(int, bool, bool);
    callback navigate(int);
    callback select-all();
    callback clear-selection();

    in property <int> selected-count;
    in property <bool> can-undo-transfer;
    // Presets: mitgelieferte zuerst; Anwenden gilt für die Auswahl bzw. das aktuelle Bild.
    in property <[PresetItem]> presets;
    callback apply-preset(int);
    callback save-preset(string);
    callback delete-preset(int);
    property <bool> naming-preset;

    // Gruppen, die beim Übernehmen auf mehrere Bilder mitkommen; in config.json gemerkt.
    in-out property <bool> transfer-color: true;
    in-out property <bool> transfer-tone: true;
    in-out property <bool> transfer-detail: true;
    in-out property <bool> transfer-geometry;
    callback transfer-groups-changed();
    callback transfer-fixed();
    callback transfer-relative();
    callback undo-transfer();

    in-out property <float> jpeg-quality: 95;
    in property <bool> exporting;
    in property <string> export-progress;
    callback export-current();
    callback export-selection();
    callback cancel-export();
    callback jpeg-quality-changed(float);

    // „In … öffnen“
    in property <[ProgramItem]> programs;
    in property <string> open-with-name;
    callback open-in-program();
    callback choose-program(int);
    callback add-program();

    // Hilfe (F1 oder „?“); Inhalt wie docs/HILFE.md.
    property <bool> show-help;
    property <[HelpSection]> help: [
        {
            title: "Bilder auswählen und vergleichen",
            lines: [
                "Übersicht (Startseite): alle Bilder des Ordners. Links „Ordner öffnen …“ (oder Ordner bzw. Bild ins Fenster ziehen), „Bildgröße“ (Doppelklick: Standard), „Vorschaubilder Original | Korrigiert“ und alle Angaben zum markierten Bild. Beim nächsten Start öffnet sich der zuletzt geöffnete Ordner.",
                "In der Übersicht: Klick wählt (Strg/Umschalt für mehrere), Pfeiltasten ← → ↑ ↓ wandern, Doppelklick oder Enter öffnet das Bild zum Bearbeiten. Oben filtern: Alle, Unbearbeitet, Nicht exportiert (das markierte Bild bleibt sichtbar).",
                "Bearbeitung: der Pfeil links oben (oder Taste G) führt zurück zur Übersicht. Darunter die Symbole Original, Split-Ansicht, Zuschneiden und Partikel; beim Darüberfahren erscheint ihr Name.",
                "Bild wechseln: Klick in die Leiste unter dem Bild oder Pfeiltasten ← →. Mausrad über der Leiste oder Scrollbalken blättert.",
                "Original zeigen: Symbol „Original“ (Auge) oder Leertaste gedrückt halten.",
                "Split-Ansicht: Symbol „Split-Ansicht“ oder Taste S; die Trennlinie mit der Maus ziehen.",
                "Zoom: Doppelklick ins Bild (100 % an dieser Stelle) oder Taste Z; Mausrad oder zwei Finger auf- und zuziehen (Touchpad, Touchbildschirm) zoomt stufenlos bis 400 %. Ziehen oder zwei Finger schieben verschiebt den Ausschnitt. Doppelklick, Z oder Esc zurück.",
                "Bildinformationen: oben rechts auf den Dateinamen klicken; ein Fenster mit allen Angaben öffnet sich, ein Klick daneben schließt es.",
            ],
        },
        {
            title: "Korrigieren",
            lines: [
                "Die Auto-Korrektur stellt Rot wieder her und spreizt die Farbkanäle für jedes Bild einzeln.",
                "Histogramm oben rechts: Rot-, Grün- und Blaukanal des korrigierten Bildes. Die Dreiecke leuchten, wenn Tiefen (links) oder Lichter (rechts) beschnitten werden, in der Farbe der betroffenen Kanäle.",
                "Klick auf ein Dreieck oder Taste J: beschnittene Stellen im Bild markieren (rot = Lichter, blau = Tiefen).",
                "Stärke: wie stark die Korrektur wirkt (0 % = Original).",
                "Der Umschalter „Farbe | Ton | Details“ unter der Stärke zeigt die jeweilige Reglergruppe; die Einstellungen der anderen Gruppen bleiben wirksam.",
                "Temperatur und Grün ↔ Magenta: Reststich ausgleichen.",
                "Pipette: Knopf drücken, dann eine eigentlich neutrale Stelle anklicken (Sand, Flosse, Graukarte).",
                "Dynamik: schwache Farben kräftiger, kräftige bleiben.",
                "Dunst entfernen: nimmt den Schleier aus Schwebeteilchen heraus; die Wasserfarbe wird aus dem ganzen Bild geschätzt. Das Bild wird dabei oft dunkler – mit Belichtung oder Tiefen ausgleichen.",
                "Belichtung: ±2 Blenden. Kontrast: S-Kurve, Schwarz und Weiß bleiben.",
                "Lichter: helle Bereiche dunkler (−) oder heller (+). Tiefen: dunkle Bereiche heller (+) oder dunkler (−). Wirkt nach der Helligkeit der Umgebung, Details bleiben erhalten.",
                "Vignette (Ton): Ecken dunkler (−) oder heller (+, gegen Blitz-Abfall). Farbmischer (unten in Farbe): Wasserfarbe dreht den Farbton von Blau und Cyan, Wasser-Sättigung macht das Wasser kräftiger oder blasser, Fische/Korallen-Sättigung wirkt auf Orange und Gelb.",
                "Details – Klarheit: Strukturen (Korallen, Schuppen) kräftiger (+) oder weicher (−), am stärksten in den Mitteltönen.",
                "Schärfen: schärft feine Strukturen; glatte Flächen wie freies Wasser bleiben ruhig.",
                "Rauschen entfernen: nimmt vor allem bunte Flecken heraus (entstehen beim Anheben von Rot) und glättet die Körnung leicht. Schärfen und Rauschen in der 100-%-Ansicht beurteilen.",
                "Doppelklick auf einen Regler setzt nur diesen zurück; „Zurücksetzen“ setzt alle zurück.",
                "Rückgängig: Strg+Z oder Pfeil nach links neben „Zurücksetzen“; Wiederholen: Strg+Y (oder Strg+Umschalt+Z) bzw. Pfeil nach rechts. Jedes Bild hat seinen eigenen Verlauf; ein Zug an einem Regler ist ein Schritt.",
            ],
        },
        {
            title: "Presets",
            lines: [
                "„Preset anwenden …“: Blauwasser, Grünwasser (See), Mit Blitz oder eigene; gilt für das aktuelle Bild bzw. alle ausgewählten.",
                "Ein Preset enthält Farbe, Ton und Details (bei Auto relativ zur Analyse jedes Bildes); Drehen und Zuschnitt bleiben.",
                "„Speichern …“ legt die Einstellungen des aktuellen Bildes unter einem Namen ab; eigene Presets lassen sich in der Liste löschen.",
            ],
        },
        {
            title: "Zuschneiden und Ausrichten",
            lines: [
                "Symbol „Zuschneiden“ links oder Taste C: ganzes Bild mit Zuschnittrahmen und Werkzeugleiste. Fertig, C, Enter oder Esc beenden; Strg+Z nimmt zurück.",
                "Ecken oder Kanten ziehen ändert die Größe, innen ziehen verschiebt. Seitenverhältnis wählbar, Hoch-/Querformat tauscht es.",
                "Geraderichten mit dem Regler (±45°) oder „Linie ziehen“: Linie entlang Horizont oder Riffkante ziehen, sie wird waagerecht bzw. senkrecht.",
                "Links/Rechts drehen und Spiegeln; der Zuschnitt dreht mit. Der Export ist aufrecht und zugeschnitten.",
            ],
        },
        {
            title: "Partikel entfernen",
            lines: [
                "Symbol „Partikel“ links oder Taste P schaltet das Werkzeug ein; Fertig, P, Enter oder Esc beenden es.",
                "Klick auf einen Schwebeteilchen-Fleck füllt ihn aus der passenden Umgebung; Klick auf einen weißen Kreis entfernt ihn wieder.",
                "Größe 4–120 px: der Kreis am Mauszeiger soll den Fleck knapp umschließen. In der 100-%-Ansicht (Z) trifft man kleine Flecken genauer.",
                "Bis zu 100 Flecken je Bild; „Alle entfernen“ löscht sie, Strg+Z nimmt einzelne zurück. Sie werden nicht auf andere Bilder übertragen.",
            ],
        },
        {
            title: "Mehrere Bilder",
            lines: [
                "Strg+Klick: Bild dazu oder weg. Umschalt+Klick: Bereich. Strg+A: alle. Esc: Auswahl aufheben.",
                "Übernommen werden die Einstellungen des blau umrandeten Bildes – nur die Gruppen, deren Schalter (Farbe, Ton, Details, Zuschnitt) markiert sind; Zuschnitt ist anfangs aus.",
                "„Gleiche Werte übernehmen“: jedes Bild bekommt genau dieselbe Korrektur – für eine Serie aus derselben Situation.",
                "„Auto + Abweichung übernehmen“: jedes Bild behält seine Auto-Analyse, deine Änderungen kommen dazu.",
                "„Letzte Übernahme rückgängig“ gilt, bis ein Regler bewegt wird.",
            ],
        },
        {
            title: "Export und Weiterbearbeiten",
            lines: [
                "Export (Strg+E, Auswahl Strg+Umschalt+E) in den Unterordner „uw-korrigiert“: gleicher Dateiname, EXIF und Farbprofil bleiben.",
                "JPG-Qualität: Pfeil rechts neben „Aktuelles Bild exportieren“.",
                "Originale werden nie verändert; ein erneuter Export ersetzt das vorherige Ergebnis.",
                "Leiste: ✓ = mit den jetzigen Einstellungen exportiert, ● = bearbeitet.",
                "Leiste „Korrigiert“: exportierte Bilder erscheinen korrigiert, alle anderen als Original.",
                "„In … öffnen“ exportiert Fehlendes zuerst und übergibt die Bilder dem Programm; der Pfeil daneben wechselt das Programm.",
                "RapidRaw öffnet bei mehreren Bildern nur eines. Lightroom Classic zeigt den Import-Dialog, LightCraft importiert in seine Bibliothek.",
                "Einstellungen jedes Bildes stehen in „uw-korrigiert\\.uwcc.json“ und sind beim nächsten Öffnen wieder da.",
            ],
        },
        {
            title: "Herkunft",
            lines: [
                "Auto-Korrektur nach „underwater-image-color-correction“ von Nikolaj Bech Andersen (GPL-3.0), github.com/nikolajbech/underwater-image-color-correction.",
            ],
        },
    ];

    // Leiste zeigt exportierte Bilder korrigiert; alle anderen bleiben Original.
    in-out property <bool> strip-corrected;
    callback strip-mode-changed(bool);

    // Regler zeigen die wirksamen Werte; Rust schreibt sie nach jeder Änderung zurück.
    in-out property <bool> auto-on: true;
    in-out property <float> v-strength: 100;
    in-out property <float> v-hue;
    in-out property <float> v-temperature;
    in-out property <float> v-tint;
    in-out property <float> v-vibrance;
    in-out property <float> v-exposure;
    in-out property <float> v-contrast;
    in-out property <float> v-highlights;
    in-out property <float> v-shadows;
    in-out property <float> v-dehaze;
    in-out property <float> v-vignette;
    in-out property <float> v-water-hue;
    in-out property <float> v-water-saturation;
    in-out property <float> v-warm-saturation;
    in-out property <float> v-clarity;
    in-out property <float> v-sharpen;
    in-out property <float> v-noise;
    // Reglergruppe unter dem Umschalter: 0 Farbe, 1 Ton, 2 Details; wird in config.json gemerkt.
    in-out property <int> panel-tab;
    callback panel-tab-changed(int);
    in-out property <bool> picking;
    property <bool> controls-enabled: root.has-preview && !root.loading;

    callback edited(string, float);
    callback auto-toggled(bool);
    callback reset();
    // Rückgängig/Wiederholen der Einstellungen des aktuellen Bildes.
    in property <bool> can-undo;
    in property <bool> can-redo;
    callback undo();
    callback redo();
    callback reset-field(string);
    // Pipette: Klickposition als Anteil von Bildbreite und -höhe (0–1).
    callback pick(float, float);

    property <length> cell-width: 104px;
    property <length> cell-height: 78px;
    property <length> cell-gap: 8px;
    property <bool> space-held;
    // Leertaste oder „Vorher“-Knopf: das ganze Bild als Original, auch in der Split-Ansicht.
    property <bool> before-pressed;
    property <bool> hold: root.space-held || root.before-pressed;
    property <float> original-fraction: root.cropping ? 0 : root.hold ? 1 : (root.split ? root.split-pos : 0);
    // Leiste filtern: 0 alle, 1 unbearbeitet, 2 nicht (aktuell) exportiert. Rust setzt die Plätze
    // (`Thumb.slot`), die Anzahl und den Platz des aktuellen Bildes, das immer sichtbar bleibt.
    in-out property <int> strip-filter;
    callback strip-filter-changed(int);
    in property <int> shown-count;
    in property <int> current-slot: -1;
    property <length> current-left: root.cell-gap + root.current-slot * (root.cell-width + root.cell-gap);

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    // Meldungen (Export, Pipette, Presets …) kurz unten im Bild statt in einer festen Zeile.
    property <bool> toast-on;
    public function notify(text: string) {
        root.status = text;
        if root.toast-on {
            toast-timer.restart();
        }
        root.toast-on = true;
    }
    toast-timer := Timer {
        interval: 5s;
        running: root.toast-on;
        triggered => {
            root.toast-on = false;
        }
    }

    // Das gewählte Bild in der Leiste sichtbar halten (Pfeiltasten, neuer Ordner, Filter).
    changed current-slot => {
        root.show-current-in-grid();
        if root.current-slot >= 0 {
            if root.current-left + strip.content-x < 0 {
                strip.content-x = root.cell-gap - root.current-left;
            } else if root.current-left + root.cell-width + strip.content-x > strip.visible-width {
                strip.content-x = strip.visible-width - root.current-left - root.cell-width - root.cell-gap;
            }
        }
    }

    keys := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            if event.text == Key.F1 {
                root.show-help = !root.show-help;
                return accept;
            }
            if root.show-help && event.text == Key.Escape {
                root.show-help = false;
                return accept;
            }
            if (event.text == "g" || event.text == "G") && !event.modifiers.control && root.thumbs.length > 0 {
                root.set-library(!root.library);
                return accept;
            }
            if root.library && event.text == Key.Return && root.current >= 0 {
                root.set-library(false);
                return accept;
            }
            if root.library && event.text == Key.UpArrow {
                root.navigate(-root.grid-cols);
                return accept;
            }
            if root.library && event.text == Key.DownArrow {
                root.navigate(root.grid-cols);
                return accept;
            }
            if (event.text == "c" || event.text == "C") && !event.modifiers.control && root.has-preview && !root.loading && !root.library {
                root.set-cropping(!root.cropping);
                return accept;
            }
            if root.cropping && (event.text == Key.Escape || event.text == Key.Return) {
                root.set-cropping(false);
                return accept;
            }
            if (event.text == "p" || event.text == "P") && !event.modifiers.control && root.has-preview && !root.loading && !root.library {
                root.set-healing(!root.healing);
                return accept;
            }
            if root.healing && (event.text == Key.Escape || event.text == Key.Return) {
                root.set-healing(false);
                return accept;
            }
            if root.zoomed && event.text == Key.Escape {
                root.zoomed = false;
                return accept;
            }
            if event.modifiers.control && (event.text == "z" || event.text == "Z") {
                if event.modifiers.shift {
                    root.redo();
                } else {
                    root.undo();
                }
                return accept;
            }
            if event.modifiers.control && (event.text == "y" || event.text == "Y") {
                root.redo();
                return accept;
            }
            if (event.text == "z" || event.text == "Z") && !event.modifiers.control && root.has-preview && !root.cropping && !root.library {
                if root.zoomed {
                    root.zoomed = false;
                } else {
                    root.zoom-to(1, preview-box.width / 2, preview-box.height / 2);
                }
                return accept;
            }
            if event.text == " " {
                root.space-held = true;
                return accept;
            }
            if event.text == Key.LeftArrow {
                root.navigate(-1);
                return accept;
            }
            if event.text == Key.RightArrow {
                root.navigate(1);
                return accept;
            }
            if event.modifiers.control && (event.text == "e" || event.text == "E") && !root.exporting {
                if event.modifiers.shift && root.selected-count > 1 {
                    root.export-selection();
                } else {
                    root.export-current();
                }
                return accept;
            }
            if event.modifiers.control && (event.text == "a" || event.text == "A") {
                root.select-all();
                return accept;
            }
            if event.text == Key.Escape {
                root.clear-selection();
                return accept;
            }
            if (event.text == "s" || event.text == "S") && root.has-preview && !root.cropping && !root.library {
                root.split = !root.split;
                return accept;
            }
            if (event.text == "j" || event.text == "J") && root.has-preview {
                root.clip-warning = !root.clip-warning;
                root.clip-warning-changed();
                return accept;
            }
            reject
        }
        key-released(event) => {
            if event.text == " " {
                root.space-held = false;
                return accept;
            }
            reject
        }
        changed has-focus => {
            if !self.has-focus {
                root.space-held = false;
            }
        }

        VerticalLayout {
            padding: 8px;
            // Abstände als eigene Elemente: die ausgeblendete Reglerleiste bekäme sonst auch einen.
            HorizontalLayout {
                vertical-stretch: 1;

                // Übersicht links: Ordner öffnen, Bildgröße, Vorschaubilder und alle Angaben zum Bild.
                if root.library: Rectangle {
                    width: 260px;
                    background: root.panel-color;
                    border-radius: 10px;
                    clip: true;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 12px;
                        alignment: start;
                        Button {
                            text: "Ordner öffnen …";
                            primary: true;
                            clicked => {
                                root.open-folder();
                                keys.focus();
                            }
                        }
                        VerticalLayout {
                            spacing: 2px;
                            HorizontalLayout {
                                Text {
                                    text: "Bildgröße";
                                    font-size: 12px;
                                }
                                Text {
                                    text: round(root.grid-size) + " px";
                                    font-size: 12px;
                                    color: #c8ccd2;
                                    horizontal-alignment: right;
                                }
                            }
                            ValueSlider {
                                minimum: 110;
                                maximum: 320;
                                value <=> root.grid-size;
                                released => {
                                    root.grid-size-changed(root.grid-size);
                                    keys.focus();
                                }
                                double-clicked => {
                                    root.grid-size = 190;
                                    root.grid-size-changed(root.grid-size);
                                    keys.focus();
                                }
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "Vorschaubilder";
                                font-size: 12px;
                            }
                            Segmented {
                                options: ["Original", "Korrigiert"];
                                selected: root.strip-corrected ? 1 : 0;
                                changed(i) => {
                                    root.strip-mode-changed(i == 1);
                                    keys.focus();
                                }
                            }
                        }
                        Rectangle {
                            height: 1px;
                            background: #ffffff14;
                        }
                        if root.info-title == "": Text {
                            text: "Kein Bild ausgewählt";
                            color: #8a8f98;
                            font-size: 12px;
                        }
                        if root.info-title != "": Heading {
                            text: root.info-title;
                            overflow: elide;
                        }
                        if root.info-title != "": VerticalLayout {
                            spacing: 5px;
                            for row in root.info-rows: HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    width: 84px;
                                    text: row.label;
                                    color: #8a8f98;
                                    font-size: 11px;
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: row.value;
                                    wrap: word-wrap;
                                    font-size: 11px;
                                }
                            }
                        }
                    }
                }

                // Bearbeitung links: zurück zur Übersicht, darunter die Ansichten und Werkzeuge.
                if !root.library: Rectangle {
                    width: 52px;
                    background: root.panel-color;
                    border-radius: 10px;
                    VerticalLayout {
                        padding: 8px;
                        spacing: 8px;
                        alignment: start;
                        ToolButton {
                            commands: "M 16 10 L 4 10 M 9 5 L 4 10 L 9 15";
                            clicked => {
                                root.set-library(true);
                                keys.focus();
                            }
                            hover(on, y) => {
                                root.show-tip(on, "Zurück zur Übersicht (G)", y);
                            }
                        }
                        Rectangle {
                            height: 10px;
                        }
                        ToolButton {
                            commands: "M 2 10 C 4.5 5.5 15.5 5.5 18 10 C 15.5 14.5 4.5 14.5 2 10 Z M 7.5 10 A 2.5 2.5 0 1 1 12.5 10 A 2.5 2.5 0 1 1 7.5 10";
                            active: self.pressed || root.space-held;
                            enabled: root.has-preview;
                            changed pressed => {
                                root.before-pressed = self.pressed;
                            }
                            clicked => {
                                keys.focus();
                            }
                            hover(on, y) => {
                                root.show-tip(on, "Original (gedrückt halten oder Leertaste)", y);
                            }
                        }
                        ToolButton {
                            commands: "M 3 4 L 17 4 L 17 16 L 3 16 Z M 10 2 L 10 18";
                            active: root.split && !root.cropping;
                            enabled: root.has-preview && !root.cropping;
                            clicked => {
                                root.split = !root.split;
                                keys.focus();
                            }
                            hover(on, y) => {
                                root.show-tip(on, "Split-Ansicht (S)", y);
                            }
                        }
                        ToolButton {
                            commands: "M 5 1 L 5 15 L 19 15 M 1 5 L 15 5 L 15 19";
                            active: root.cropping;
                            enabled: root.has-preview && !root.loading;
                            clicked => {
                                root.set-cropping(!root.cropping);
                                keys.focus();
                            }
                            hover(on, y) => {
                                root.show-tip(on, "Zuschneiden und Ausrichten (C)", y);
                            }
                        }
                        ToolButton {
                            commands: "M 3 10 A 7 7 0 1 1 17 10 A 7 7 0 1 1 3 10 M 10 7 L 10 13 M 7 10 L 13 10";
                            active: root.healing;
                            enabled: root.has-preview && !root.loading;
                            clicked => {
                                root.set-healing(!root.healing);
                                keys.focus();
                            }
                            hover(on, y) => {
                                root.show-tip(on, "Partikel entfernen (P)", y);
                            }
                        }
                    }
                    HelpButton {
                        x: (parent.width - self.width) / 2;
                        y: parent.height - self.height - 12px;
                        clicked => {
                            root.show-help = true;
                            keys.focus();
                        }
                    }
                }

                Rectangle {
                    width: 8px;
                }

                // Mitte: Kopf der Übersicht, Raster bzw. Bild, darunter in der Bearbeitung die Bildleiste.
                Rectangle {
                    horizontal-stretch: 1;
                    background: root.panel-color;
                    border-radius: 10px;
                    clip: true;

                    VerticalLayout {
                        Rectangle {
                            height: root.library ? 66px : 0px;
                            visible: root.library;
                            HorizontalLayout {
                                padding-left: 18px;
                                padding-right: 14px;
                                padding-top: 10px;
                                spacing: 12px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    Text {
                                        text: "Übersicht";
                                        font-size: 20px;
                                        font-weight: 700;
                                    }
                                    Text {
                                        text: root.thumbs.length == 0 ? "Kein Ordner geöffnet"
                                            : root.folder + "   ·   " + root.thumbs.length + " Bilder"
                                            + (root.strip-filter != 0 ? ", " + root.shown-count + " angezeigt" : "");
                                        color: #8a8f98;
                                        font-size: 12px;
                                        overflow: elide;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Segmented {
                                        width: 270px;
                                        options: ["Alle", "Unbearbeitet", "Nicht exportiert"];
                                        selected: root.strip-filter;
                                        changed(i) => {
                                            root.strip-filter = i;
                                            root.strip-filter-changed(i);
                                            keys.focus();
                                        }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    HelpButton {
                                        clicked => {
                                            root.show-help = true;
                                            keys.focus();
                                        }
                                    }
                                }
                            }
                        }

                        // Vorschau: unten das bearbeitete Bild, darüber das Original bis `original-fraction`.
                        preview-box := Rectangle {
                            vertical-stretch: 1;
                            clip: true;

                            if root.has-preview && !root.zoomed && !root.cropping: Image {
                                width: 100%;
                                height: 100%;
                                source: root.preview-corrected;
                                image-fit: contain;
                            }
                            // Zoom: Ausschnitt maßstabsgerecht; über 100 % pixelgenau vergrößert.
                            if root.has-preview && root.zoomed: Image {
                                x: preview-box.width / 2 + (root.zoom-x - root.zoom-cx) * root.zoom-scale * 1phx;
                                y: preview-box.height / 2 + (root.zoom-y - root.zoom-cy) * root.zoom-scale * 1phx;
                                width: root.zoom-w * root.zoom-scale * 1phx;
                                height: root.zoom-h * root.zoom-scale * 1phx;
                                source: root.zoom-corrected;
                                image-rendering: root.zoom-scale > 1.01 ? ImageRendering.pixelated : ImageRendering.smooth;
                            }
                            if root.has-preview && root.original-fraction > 0: Rectangle {
                                x: 0;
                                y: 0;
                                width: preview-box.width * root.original-fraction;
                                height: 100%;
                                clip: true;
                                if !root.zoomed: Image {
                                    x: 0;
                                    y: 0;
                                    width: preview-box.width;
                                    height: preview-box.height;
                                    source: root.preview-original;
                                    image-fit: contain;
                                }
                                if root.zoomed: Image {
                                    x: preview-box.width / 2 + (root.zoom-x - root.zoom-cx) * root.zoom-scale * 1phx;
                                    y: preview-box.height / 2 + (root.zoom-y - root.zoom-cy) * root.zoom-scale * 1phx;
                                    width: root.zoom-w * root.zoom-scale * 1phx;
                                    height: root.zoom-h * root.zoom-scale * 1phx;
                                    source: root.zoom-original;
                                    image-rendering: root.zoom-scale > 1.01 ? ImageRendering.pixelated : ImageRendering.smooth;
                                }
                            }
                            if root.has-preview && root.split && !root.hold && !root.cropping: Rectangle {
                                x: preview-box.width * root.split-pos - 1px;
                                width: 2px;
                                height: 100%;
                                background: white;
                            }
                            if root.has-preview && root.split && !root.hold && !root.cropping: Rectangle {
                                x: preview-box.width * root.split-pos - 14px;
                                y: preview-box.height / 2 - 14px;
                                width: 28px;
                                height: 28px;
                                border-radius: 14px;
                                background: white;
                                // Zwei Dreiecke selbst gezeichnet; Schriftzeichen sitzen nicht mittig.
                                Path {
                                    width: 100%;
                                    height: 100%;
                                    viewbox-width: 28;
                                    viewbox-height: 28;
                                    commands: "M 11.5 8.5 L 5 14 L 11.5 19.5 Z M 16.5 8.5 L 23 14 L 16.5 19.5 Z";
                                    fill: Palette.accent-background;
                                    stroke-width: 0px;
                                }
                            }
                            if root.has-preview && root.split && !root.hold && !root.cropping: Tag {
                                x: 12px;
                                y: 12px;
                                text: "Original";
                            }
                            if root.has-preview && root.split && !root.hold && !root.cropping: Tag {
                                x: preview-box.width - self.width - 12px;
                                y: 12px;
                                text: "Korrigiert";
                            }
                            if root.has-preview && root.hold && !root.cropping: Tag {
                                x: 12px;
                                y: 12px;
                                text: "Original";
                            }
                            if root.loading || (root.zoomed && root.zoom-corrected.width == 0): Tag {
                                x: (preview-box.width - self.width) / 2;
                                y: 12px;
                                text: "Lade …";
                            }
                            if root.has-preview && root.zoomed: Tag {
                                x: 12px;
                                y: preview-box.height - self.height - 12px;
                                text: round(root.zoom-scale * 100) + " %";
                            }
                            if !root.has-preview: Text {
                                text: root.thumbs.length == 0 ? "Ordner öffnen oder hierher ziehen" : "Bild in der Leiste auswählen";
                                color: #8a8f98;
                                font-size: 20px;
                            }
                            if root.drag-over: Rectangle {
                                border-width: 3px;
                                border-color: Palette.accent-background;
                                background: Palette.accent-background.transparentize(0.87);
                            }

                            // Ohne Zoom verschiebt jeder Klick die Split-Linie; mit Zoom nur ein Griff an der
                            // Linie, sonst verschiebt Ziehen den Ausschnitt.
                            preview-touch := TouchArea {
                                property <bool> panning;
                                property <bool> splitting;
                                property <length> start-x;
                                property <length> start-y;
                                property <float> start-cx;
                                property <float> start-cy;
                                property <bool> on-split: root.has-preview && root.split && !root.hold && !root.healing
                                    && (!root.zoomed || abs(self.mouse-x - preview-box.width * root.split-pos) < 12px);
                                mouse-cursor: root.picking || root.healing ? MouseCursor.crosshair
                                    : self.on-split || self.splitting ? MouseCursor.ew-resize
                                    : self.panning ? MouseCursor.move
                                    : MouseCursor.default;
                                pointer-event(event) => {
                                    // Partikel-Werkzeug: ein Klick ohne Ziehen setzt bzw. entfernt einen Partikel;
                                    // Ziehen verschiebt im Zoom weiterhin den Ausschnitt.
                                    if root.healing && event.button == PointerEventButton.left && event.kind == PointerEventKind.up
                                        && abs(self.mouse-x - self.start-x) < 4px && abs(self.mouse-y - self.start-y) < 4px {
                                        root.heal-click(root.image-x(self.mouse-x), root.image-y(self.mouse-y));
                                    }
                                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                        keys.focus();
                                        self.start-x = self.mouse-x;
                                        self.start-y = self.mouse-y;
                                        if root.picking {
                                            root.picking = false;
                                            root.pick(root.image-x(self.mouse-x) / root.full-width, root.image-y(self.mouse-y) / root.full-height);
                                        } else if self.on-split {
                                            self.splitting = true;
                                            root.split-pos = clamp(self.mouse-x / self.width, 0, 1);
                                        } else if root.zoomed {
                                            self.panning = true;
                                            self.start-x = self.mouse-x;
                                            self.start-y = self.mouse-y;
                                            self.start-cx = root.zoom-cx;
                                            self.start-cy = root.zoom-cy;
                                        }
                                    }
                                    // Beginnt eine Zwei-Finger-Geste, bricht Slint das Ziehen mit `cancel` ab.
                                    if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                                        self.panning = false;
                                        self.splitting = false;
                                    }
                                }
                                moved => {
                                    if self.splitting {
                                        root.split-pos = clamp(self.mouse-x / self.width, 0, 1);
                                    } else if self.panning {
                                        root.set-center(self.start-cx - (self.mouse-x - self.start-x) / 1phx / root.zoom-scale,
                                            self.start-cy - (self.mouse-y - self.start-y) / 1phx / root.zoom-scale);
                                        root.zoom-changed();
                                    }
                                }
                                // Mausrad und Pinch (kommt unter Windows als Strg+Rad) zoomen um den
                                // Mauszeiger; zwei Finger auf dem Touchpad verschieben den Ausschnitt.
                                scroll-event(event) => {
                                    if !root.has-preview || root.loading || root.picking || root.cropping {
                                        return reject;
                                    }
                                    if event.modifiers.control || !root.wheel-from-touchpad {
                                        root.zoom-to((root.zoomed ? root.zoom-scale : root.fit-scale) * pow(1.004, event.delta-y / 1px), self.mouse-x, self.mouse-y);
                                        return accept;
                                    }
                                    if root.zoomed {
                                        root.set-center(root.zoom-cx - event.delta-x / 1phx / root.zoom-scale, root.zoom-cy - event.delta-y / 1phx / root.zoom-scale);
                                        root.zoom-changed();
                                        return accept;
                                    }
                                    reject
                                }
                                double-clicked => {
                                    if root.has-preview && !root.picking && !root.cropping && !root.healing {
                                        if root.zoomed {
                                            root.zoomed = false;
                                        } else {
                                            root.zoom-to(1, self.mouse-x, self.mouse-y);
                                        }
                                    }
                                }
                            }
                            // Zwei Finger auf dem Touchbildschirm: auseinanderziehen zoomt um den Mittelpunkt,
                            // gemeinsam schieben verschiebt. Liegt über der TouchArea und lässt alles andere durch.
                            ScaleRotateGestureHandler {
                                property <float> start-scale;
                                property <length> last-x;
                                property <length> last-y;
                                enabled: root.has-preview && !root.loading && !root.cropping;
                                started => {
                                    self.start-scale = root.zoomed ? root.zoom-scale : root.fit-scale;
                                    self.last-x = self.center.x;
                                    self.last-y = self.center.y;
                                }
                                updated => {
                                    root.zoom-to(self.start-scale * self.scale, self.center.x, self.center.y);
                                    if root.zoomed {
                                        root.set-center(root.zoom-cx - (self.center.x - self.last-x) / 1phx / root.zoom-scale,
                                            root.zoom-cy - (self.center.y - self.last-y) / 1phx / root.zoom-scale);
                                        root.zoom-changed();
                                    }
                                    self.last-x = self.center.x;
                                    self.last-y = self.center.y;
                                }
                            }

                            // Partikel-Werkzeug: Kreise der gesetzten Partikel, Vorschaukreis am Mauszeiger,
                            // Werkzeugleiste oben.
                            if root.has-preview && root.healing && !root.cropping: Rectangle {
                                for m in root.spot-marks: Rectangle {
                                    x: root.screen-x(m.x) - root.screen-len(m.r);
                                    y: root.screen-y(m.y) - root.screen-len(m.r);
                                    width: 2 * root.screen-len(m.r);
                                    height: self.width;
                                    border-radius: self.width / 2;
                                    border-width: 1.5px;
                                    border-color: #ffffffd8;
                                }
                                if preview-touch.has-hover: Rectangle {
                                    x: preview-touch.mouse-x - root.screen-len(root.heal-size / 2);
                                    y: preview-touch.mouse-y - root.screen-len(root.heal-size / 2);
                                    width: root.screen-len(root.heal-size);
                                    height: self.width;
                                    border-radius: self.width / 2;
                                    border-width: 1px;
                                    border-color: Palette.accent-background;
                                }
                                Rectangle {
                                    x: (parent.width - self.width) / 2;
                                    y: 10px;
                                    width: min(parent.width - 20px, 640px);
                                    height: 44px;
                                    border-radius: 8px;
                                    background: #000000c8;
                                    TouchArea { }
                                    HorizontalLayout {
                                        padding: 8px;
                                        spacing: 8px;
                                        Text {
                                            text: "Partikel: Klick setzt, Klick auf Kreis entfernt";
                                            vertical-alignment: center;
                                            font-size: 12px;
                                        }
                                        Text {
                                            text: "Größe";
                                            vertical-alignment: center;
                                            font-size: 12px;
                                            color: #c8ccd2;
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            horizontal-stretch: 1;
                                            ValueSlider {
                                                minimum: 4;
                                                maximum: 120;
                                                value <=> root.heal-size;
                                                released => {
                                                    keys.focus();
                                                }
                                                double-clicked => {
                                                    root.heal-size = 24;
                                                    keys.focus();
                                                }
                                            }
                                        }
                                        Text {
                                            width: 44px;
                                            text: round(root.heal-size) + " px";
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                            font-size: 12px;
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            HorizontalLayout {
                                                spacing: 6px;
                                                SmallButton {
                                                    text: "Alle entfernen (" + root.spot-marks.length + ")";
                                                    enabled: root.spot-marks.length > 0;
                                                    clicked => {
                                                        root.clear-spots();
                                                        keys.focus();
                                                    }
                                                }
                                                SmallButton {
                                                    text: "Fertig (P)";
                                                    active: true;
                                                    clicked => {
                                                        root.set-healing(false);
                                                        keys.focus();
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                visible: root.library;
                                background: root.panel-color;

                                if root.thumbs.length == 0: Text {
                                    text: root.drag-over ? "Loslassen zum Öffnen" : "Ordner öffnen (links oben) oder hierher ziehen";
                                    color: root.drag-over ? Palette.accent-background : #8a8f98;
                                    font-size: 16px;
                                }

                                grid := ScrollView {
                                    width: 100%;
                                    height: 100%;
                                    content-width: self.visible-width;
                                    content-height: ceil(root.shown-count / root.grid-cols) * (root.grid-cell-height + root.cell-gap) + root.cell-gap;
                                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

                                    for thumb[i] in root.thumbs: Rectangle {
                                        visible: thumb.slot >= 0;
                                        x: root.cell-gap + mod(thumb.slot, root.grid-cols) * (root.grid-cell-width + root.cell-gap);
                                        y: root.cell-gap + floor(thumb.slot / root.grid-cols) * (root.grid-cell-height + root.cell-gap);
                                        width: root.grid-cell-width;
                                        height: root.grid-cell-height;
                                        border-radius: 6px;
                                        background: #26272c;
                                        clip: true;

                                        Image {
                                            width: 100%;
                                            height: 100%;
                                            source: root.strip-corrected && thumb.has-corrected ? thumb.corrected : thumb.image;
                                            image-fit: cover;
                                        }
                                        if !thumb.loaded: Text {
                                            text: "…";
                                            color: #6b7078;
                                        }
                                        if thumb.failed: Text {
                                            text: "nicht lesbar";
                                            color: #e5484d;
                                            font-size: 11px;
                                        }
                                        // Name unten links auf einem Verlauf, damit er auf hellen Bildern lesbar bleibt.
                                        Rectangle {
                                            y: parent.height - self.height;
                                            height: 30px;
                                            background: @linear-gradient(0deg, #000000a0 0%, #00000000 100%);
                                        }
                                        Text {
                                            x: 9px;
                                            y: parent.height - 21px;
                                            width: parent.width - 18px;
                                            text: thumb.name;
                                            font-size: 11px;
                                            color: white;
                                            overflow: elide;
                                        }
                                        if thumb.exported: Rectangle {
                                            x: 8px;
                                            y: 8px;
                                            width: 18px;
                                            height: 18px;
                                            border-radius: 9px;
                                            background: #2ea043;
                                            border-width: 1px;
                                            border-color: #141518;
                                            Text {
                                                text: "✓";
                                                color: white;
                                                font-size: 11px;
                                                font-weight: 700;
                                            }
                                        }
                                        if thumb.edited: Rectangle {
                                            x: parent.width - 18px;
                                            y: 10px;
                                            width: 10px;
                                            height: 10px;
                                            border-radius: 5px;
                                            background: #f5a623;
                                            border-width: 1px;
                                            border-color: #141518;
                                        }
                                        Rectangle {
                                            border-radius: 6px;
                                            border-width: i == root.current ? 3px : (thumb.selected ? 3px : 0px);
                                            border-color: i == root.current ? Palette.accent-background : Palette.accent-background.transparentize(0.45);
                                        }
                                        TouchArea {
                                            pointer-event(event) => {
                                                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                                    keys.focus();
                                                    root.thumb-pressed(i, event.modifiers.control, event.modifiers.shift);
                                                }
                                            }
                                            double-clicked => {
                                                root.set-library(false);
                                                keys.focus();
                                            }
                                        }
                                    }
                                }
                            }

                            if root.toast-on: Rectangle {
                                x: (preview-box.width - self.width) / 2;
                                y: preview-box.height - self.height - 48px;
                                width: min(toast-text.preferred-width + 28px, preview-box.width * 0.8);
                                height: toast-text.preferred-height + 16px;
                                border-radius: 6px;
                                background: #000000c8;
                                toast-text := Text {
                                    x: 14px;
                                    width: parent.width - 28px;
                                    text: root.status;
                                    wrap: word-wrap;
                                    horizontal-alignment: center;
                                    color: white;
                                    font-size: 13px;
                                }
                            }

                            // Zuschneiden: ganzer Rahmen, außerhalb des Zuschnitts abgedunkelt, mit Drittel-Raster,
                            // Griffen und Werkzeugleiste. Beim Loslassen geht der Zuschnitt an Rust (ein Schritt
                            // fürs Rückgängigmachen).
                            if root.has-preview && root.cropping: crop-box := Rectangle {
                                property <length> top: 96px;
                                property <length> margin: 24px;
                                property <length> fit: min((self.width - 2 * self.margin) / root.frame-width,
                                    (self.height - self.top - self.margin) / root.frame-height);
                                property <length> iw: root.frame-width * self.fit;
                                property <length> ih: root.frame-height * self.fit;
                                property <length> ix: (self.width - self.iw) / 2;
                                property <length> iy: self.top + (self.height - self.top - self.margin - self.ih) / 2;
                                property <length> rx: self.ix + root.crop-x * self.iw;
                                property <length> ry: self.iy + root.crop-y * self.ih;
                                property <length> rw: root.crop-w * self.iw;
                                property <length> rh: root.crop-h * self.ih;
                                background: #141518;

                                Image {
                                    x: crop-box.ix;
                                    y: crop-box.iy;
                                    width: crop-box.iw;
                                    height: crop-box.ih;
                                    source: root.preview-corrected;
                                }
                                Rectangle {
                                    x: crop-box.ix;
                                    y: crop-box.iy;
                                    width: crop-box.iw;
                                    height: crop-box.ry - crop-box.iy;
                                    background: #000000a8;
                                }
                                Rectangle {
                                    x: crop-box.ix;
                                    y: crop-box.ry + crop-box.rh;
                                    width: crop-box.iw;
                                    height: crop-box.iy + crop-box.ih - crop-box.ry - crop-box.rh;
                                    background: #000000a8;
                                }
                                Rectangle {
                                    x: crop-box.ix;
                                    y: crop-box.ry;
                                    width: crop-box.rx - crop-box.ix;
                                    height: crop-box.rh;
                                    background: #000000a8;
                                }
                                Rectangle {
                                    x: crop-box.rx + crop-box.rw;
                                    y: crop-box.ry;
                                    width: crop-box.ix + crop-box.iw - crop-box.rx - crop-box.rw;
                                    height: crop-box.rh;
                                    background: #000000a8;
                                }
                                for k in [1, 2]: Rectangle {
                                    x: crop-box.rx + crop-box.rw * k / 3;
                                    y: crop-box.ry;
                                    width: 1px;
                                    height: crop-box.rh;
                                    background: #ffffff60;
                                }
                                for k in [1, 2]: Rectangle {
                                    x: crop-box.rx;
                                    y: crop-box.ry + crop-box.rh * k / 3;
                                    width: crop-box.rw;
                                    height: 1px;
                                    background: #ffffff60;
                                }
                                Rectangle {
                                    x: crop-box.rx;
                                    y: crop-box.ry;
                                    width: crop-box.rw;
                                    height: crop-box.rh;
                                    border-width: 1px;
                                    border-color: white;
                                }
                                // Griffe: Ecken immer, Kantenmitten nur ohne festes Seitenverhältnis.
                                for c in [{x: 0, y: 0, edge: false}, {x: 1, y: 0, edge: false}, {x: 0, y: 1, edge: false},
                                    {x: 1, y: 1, edge: false}, {x: 0.5, y: 0, edge: true}, {x: 0.5, y: 1, edge: true},
                                    {x: 0, y: 0.5, edge: true}, {x: 1, y: 0.5, edge: true}]: Rectangle {
                                    visible: !c.edge || root.crop-ratio == 0;
                                    x: crop-box.rx + crop-box.rw * c.x - 6px;
                                    y: crop-box.ry + crop-box.rh * c.y - 6px;
                                    width: 12px;
                                    height: 12px;
                                    background: white;
                                    border-width: 1px;
                                    border-color: #00000080;
                                }
                                if crop-touch.mode == 4: Path {
                                    width: 100%;
                                    height: 100%;
                                    viewbox-width: crop-box.width / 1px;
                                    viewbox-height: crop-box.height / 1px;
                                    commands: "M " + crop-touch.sx / 1px + " " + crop-touch.sy / 1px
                                        + " L " + crop-touch.mouse-x / 1px + " " + crop-touch.mouse-y / 1px;
                                    stroke: #ffd400;
                                    stroke-width: 2px;
                                    fill: transparent;
                                }

                                // Ziehen: Ecke oder Kante ändert die Größe, innen verschieben; mit „Linie ziehen“ eine
                                // Linie, die danach waagerecht bzw. senkrecht wird.
                                crop-touch := TouchArea {
                                    property <int> mode; // 0 nichts, 1 verschieben, 2 Ecke, 3 Kante, 4 Linie
                                    property <int> hx; // gezogene Seite waagerecht: 0 links, 1 rechts, −1 keine
                                    property <int> hy; // senkrecht: 0 oben, 1 unten, −1 keine
                                    property <length> sx;
                                    property <length> sy;
                                    property <float> x0;
                                    property <float> y0;
                                    property <float> w0;
                                    property <float> h0;
                                    property <length> near: 14px;
                                    property <bool> at-left: abs(self.mouse-x - crop-box.rx) <= self.near;
                                    property <bool> at-right: abs(self.mouse-x - crop-box.rx - crop-box.rw) <= self.near;
                                    property <bool> at-top: abs(self.mouse-y - crop-box.ry) <= self.near;
                                    property <bool> at-bottom: abs(self.mouse-y - crop-box.ry - crop-box.rh) <= self.near;
                                    property <bool> in-x: self.mouse-x > crop-box.rx && self.mouse-x < crop-box.rx + crop-box.rw;
                                    property <bool> in-y: self.mouse-y > crop-box.ry && self.mouse-y < crop-box.ry + crop-box.rh;
                                    property <bool> on-corner: (self.at-left || self.at-right) && (self.at-top || self.at-bottom);
                                    property <bool> on-side: root.crop-ratio == 0 && (((self.at-left || self.at-right) && self.in-y)
                                        || ((self.at-top || self.at-bottom) && self.in-x));
                                    mouse-cursor: root.line-tool ? MouseCursor.crosshair
                                        : self.on-corner ? ((self.at-left == self.at-top) ? MouseCursor.nwse-resize : MouseCursor.nesw-resize)
                                        : self.on-side ? ((self.at-left || self.at-right) ? MouseCursor.ew-resize : MouseCursor.ns-resize)
                                        : self.in-x && self.in-y ? MouseCursor.move : MouseCursor.default;

                                    pointer-event(event) => {
                                        if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                            keys.focus();
                                            self.sx = self.mouse-x;
                                            self.sy = self.mouse-y;
                                            self.x0 = root.crop-x;
                                            self.y0 = root.crop-y;
                                            self.w0 = root.crop-w;
                                            self.h0 = root.crop-h;
                                            if root.line-tool {
                                                self.mode = 4;
                                            } else if self.on-corner {
                                                self.mode = 2;
                                                self.hx = self.at-left ? 0 : 1;
                                                self.hy = self.at-top ? 0 : 1;
                                            } else if self.on-side {
                                                self.mode = 3;
                                                self.hx = self.at-left ? 0 : self.at-right ? 1 : -1;
                                                self.hy = self.hx != -1 ? -1 : self.at-top ? 0 : 1;
                                            } else if self.in-x && self.in-y {
                                                self.mode = 1;
                                            } else {
                                                self.mode = 0;
                                            }
                                        }
                                        if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                                            if self.mode == 4 {
                                                let dx = (self.mouse-x - self.sx) / 1px;
                                                let dy = (self.mouse-y - self.sy) / 1px;
                                                if abs(dx) + abs(dy) > 10 {
                                                    // Winkel der Linie auf −90 … 90°, dann zur nächsten Waagerechten bzw. Senkrechten.
                                                    let raw = atan2(dy, dx) / 1deg;
                                                    let a = raw > 90 ? raw - 180 : raw <= -90 ? raw + 180 : raw;
                                                    let tilt = abs(a) <= 45 ? a : a > 0 ? a - 90 : a + 90;
                                                    root.edited("straighten", clamp(root.v-straighten - tilt, -45, 45));
                                                }
                                                root.line-tool = false;
                                            } else if self.mode != 0 {
                                                root.crop-changed(root.crop-x, root.crop-y, root.crop-w, root.crop-h);
                                            }
                                            self.mode = 0;
                                        }
                                    }
                                    moved => {
                                        if self.pressed && (self.mode == 1 || self.mode == 2 || self.mode == 3) {
                                            let dx = (self.mouse-x - self.sx) / crop-box.iw;
                                            let dy = (self.mouse-y - self.sy) / crop-box.ih;
                                            if self.mode == 1 {
                                                root.crop-x = clamp(self.x0 + dx, 0, 1 - self.w0);
                                                root.crop-y = clamp(self.y0 + dy, 0, 1 - self.h0);
                                            } else if self.mode == 3 || root.crop-ratio == 0 {
                                                if self.hx == 0 {
                                                    let left = clamp(self.x0 + dx, 0, self.x0 + self.w0 - 0.05);
                                                    root.crop-x = left;
                                                    root.crop-w = self.x0 + self.w0 - left;
                                                }
                                                if self.hx == 1 {
                                                    root.crop-w = clamp(self.w0 + dx, 0.05, 1 - self.x0);
                                                }
                                                if self.hy == 0 {
                                                    let upper = clamp(self.y0 + dy, 0, self.y0 + self.h0 - 0.05);
                                                    root.crop-y = upper;
                                                    root.crop-h = self.y0 + self.h0 - upper;
                                                }
                                                if self.hy == 1 {
                                                    root.crop-h = clamp(self.h0 + dy, 0.05, 1 - self.y0);
                                                }
                                            } else {
                                                // Festes Verhältnis: die gegenüberliegende Ecke bleibt, Höhe = Breite · k.
                                                let ax = self.hx == 0 ? self.x0 + self.w0 : self.x0;
                                                let ay = self.hy == 0 ? self.y0 + self.h0 : self.y0;
                                                let px = clamp((self.hx == 0 ? self.x0 : self.x0 + self.w0) + dx, 0, 1);
                                                let room-x = self.hx == 0 ? ax : 1 - ax;
                                                let room-y = self.hy == 0 ? ay : 1 - ay;
                                                let k = root.frame-width / root.frame-height / root.ratio;
                                                let w = min(clamp(abs(px - ax), 0.05, room-x), room-y / k);
                                                let h = w * k;
                                                root.crop-x = self.hx == 0 ? ax - w : ax;
                                                root.crop-y = self.hy == 0 ? ay - h : ay;
                                                root.crop-w = w;
                                                root.crop-h = h;
                                            }
                                        }
                                    }
                                }

                                // Werkzeugleiste
                                Rectangle {
                                    x: (crop-box.width - self.width) / 2;
                                    y: 10px;
                                    width: min(crop-box.width - 20px, 780px);
                                    height: 76px;
                                    border-radius: 8px;
                                    background: #000000c8;
                                    // Klicks auf die Leiste erreichen den Zuschnitt darunter nicht.
                                    TouchArea { }
                                    VerticalLayout {
                                        padding: 8px;
                                        spacing: 6px;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Text {
                                                text: "Seitenverhältnis";
                                                vertical-alignment: center;
                                                font-size: 12px;
                                            }
                                            ComboBox {
                                                width: 110px;
                                                model: ["Frei", "Original", "3:2", "4:3", "1:1", "16:9", "4:5"];
                                                current-index <=> root.crop-ratio;
                                                selected(value) => {
                                                    root.apply-ratio();
                                                    keys.focus();
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                SmallButton {
                                                    text: root.crop-portrait ? "Hochformat" : "Querformat";
                                                    enabled: root.crop-ratio != 0 && root.crop-ratio != 4;
                                                    clicked => {
                                                        root.crop-portrait = !root.crop-portrait;
                                                        root.apply-ratio();
                                                        keys.focus();
                                                    }
                                                }
                                            }
                                            Rectangle {
                                                horizontal-stretch: 1;
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    SmallButton {
                                                        text: "Links drehen";
                                                        clicked => {
                                                            root.rotate(false);
                                                            keys.focus();
                                                        }
                                                    }
                                                    SmallButton {
                                                        text: "Rechts drehen";
                                                        clicked => {
                                                            root.rotate(true);
                                                            keys.focus();
                                                        }
                                                    }
                                                    SmallButton {
                                                        text: "Spiegeln";
                                                        clicked => {
                                                            root.flip();
                                                            keys.focus();
                                                        }
                                                    }
                                                    SmallButton {
                                                        text: "Zurücksetzen";
                                                        clicked => {
                                                            root.reset-geometry();
                                                            keys.focus();
                                                        }
                                                    }
                                                    SmallButton {
                                                        text: "Fertig (C)";
                                                        active: true;
                                                        clicked => {
                                                            root.set-cropping(false);
                                                            keys.focus();
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text {
                                                text: "Geraderichten";
                                                vertical-alignment: center;
                                                font-size: 12px;
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                horizontal-stretch: 1;
                                                ValueSlider {
                                                    minimum: -45;
                                                    maximum: 45;
                                                    value <=> root.v-straighten;
                                                    changed(v) => {
                                                        root.edited("straighten", v);
                                                    }
                                                    released => {
                                                        keys.focus();
                                                    }
                                                    double-clicked => {
                                                        root.reset-field("straighten");
                                                        keys.focus();
                                                    }
                                                }
                                            }
                                            Text {
                                                width: 48px;
                                                text: round(root.v-straighten * 10) / 10 + "°";
                                                horizontal-alignment: right;
                                                vertical-alignment: center;
                                                font-size: 12px;
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                SmallButton {
                                                    text: "Linie ziehen";
                                                    active: root.line-tool;
                                                    clicked => {
                                                        root.line-tool = !root.line-tool;
                                                        keys.focus();
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Bildleiste unter dem Bild (nur in der Bearbeitung): Bilder füllen die Zellen wie in der
                        // Übersicht; Name und Angaben stehen in der Reglerleiste.
                        Rectangle {
                            height: root.library ? 0px : root.cell-height + 32px;
                            visible: !root.library;

                            // Slint scrollt eine nur waagerecht scrollbare Liste nicht mit dem senkrechten Mausrad.
                            TouchArea {
                                scroll-event(event) => {
                                    if event.delta-y == 0px {
                                        return reject;
                                    }
                                    strip.content-x = clamp(
                                        strip.content-x + event.delta-y,
                                        min(0px, strip.visible-width - strip.content-width),
                                        0px);
                                    accept
                                }

                                strip := ScrollView {
                                    width: 100%;
                                    height: root.cell-height + 12px;
                                    y: 0;
                                    content-width: root.shown-count * (root.cell-width + root.cell-gap) + root.cell-gap;
                                    content-height: self.visible-height;
                                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

                                    for thumb[i] in root.thumbs: Rectangle {
                                        visible: thumb.slot >= 0;
                                        x: root.cell-gap + thumb.slot * (root.cell-width + root.cell-gap);
                                        y: 6px;
                                        width: root.cell-width;
                                        height: root.cell-height;
                                        border-radius: 5px;
                                        background: #26272c;
                                        clip: true;

                                        Image {
                                            width: 100%;
                                            height: 100%;
                                            source: root.strip-corrected && thumb.has-corrected ? thumb.corrected : thumb.image;
                                            image-fit: cover;
                                        }
                                        if !thumb.loaded: Text {
                                            text: "…";
                                            color: #6b7078;
                                        }
                                        if thumb.failed: Text {
                                            text: "nicht lesbar";
                                            color: #e5484d;
                                            font-size: 11px;
                                        }
                                        if thumb.exported: Rectangle {
                                            x: 5px;
                                            y: parent.height - 21px;
                                            width: 16px;
                                            height: 16px;
                                            border-radius: 8px;
                                            background: #2ea043;
                                            border-width: 1px;
                                            border-color: #141518;
                                            Text {
                                                text: "✓";
                                                color: white;
                                                font-size: 10px;
                                                font-weight: 700;
                                            }
                                        }
                                        if thumb.edited: Rectangle {
                                            x: parent.width - 15px;
                                            y: 5px;
                                            width: 10px;
                                            height: 10px;
                                            border-radius: 5px;
                                            background: #f5a623;
                                            border-width: 1px;
                                            border-color: #141518;
                                        }
                                        Rectangle {
                                            border-radius: 5px;
                                            border-width: i == root.current ? 2px : (thumb.selected ? 2px : 0px);
                                            border-color: i == root.current ? Palette.accent-background : Palette.accent-background.transparentize(0.45);
                                        }
                                        TouchArea {
                                            pointer-event(event) => {
                                                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                                    keys.focus();
                                                    root.thumb-pressed(i, event.modifiers.control, event.modifiers.shift);
                                                }
                                            }
                                        }
                                    }
                                }
                                HScrollbar {
                                    x: 8px;
                                    y: root.cell-height + 16px;
                                    width: parent.width - 16px;
                                    height: 8px;
                                    content-width: strip.content-width;
                                    visible-width: strip.visible-width;
                                    content-x <=> strip.content-x;
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    width: root.library ? 0px : 8px;
                }

                // Reglerleiste; in der Rasteranzeige ausgeblendet. Der Inhalt bleibt 300 px breit: zu
                // Breite 0 zusammengedrückt bräche jeder Text Wort für Wort um, die Leiste würde sehr
                // hoch und schöbe die Leiste unter dem Bild aus dem Fenster.
                Rectangle {
                    width: root.library ? 0px : 300px;
                    visible: !root.library;
                    clip: root.library;
                    background: root.panel-color;
                    border-radius: 10px;

                    VerticalLayout {
                        x: 0;
                        width: 300px;
                        padding: 14px;
                        spacing: 10px;

                        Histogram {
                            height: 96px;
                            red: root.hist-red;
                            green: root.hist-green;
                            blue: root.hist-blue;
                            clip-shadows: root.clip-shadows;
                            clip-highlights: root.clip-highlights;
                            warning: root.clip-warning;
                            toggled => {
                                if root.has-preview {
                                    root.clip-warning = !root.clip-warning;
                                    root.clip-warning-changed();
                                }
                                keys.focus();
                            }
                        }

                        // Fest stehen Bildinfo, Auto-Korrektur, Stärke und Umschalter; nur die Regler der
                        // gewählten Gruppe scrollen.
                        if root.info-title != "": TouchArea {
                            height: info-heading.preferred-height;
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                info-popup.show();
                            }
                            // Dreieck selbst gezeichnet: Windows zeigt ◀ sonst als Emoji.
                            Path {
                                x: 0;
                                y: (parent.height - 10px) / 2;
                                width: 10px;
                                height: 10px;
                                viewbox-width: 10;
                                viewbox-height: 10;
                                commands: "M 8 0 L 2 5 L 8 10 Z";
                                fill: #c8ccd2;
                                stroke-width: 0px;
                            }
                            info-heading := Heading {
                                x: 16px;
                                width: parent.width - 16px;
                                text: root.info-title;
                                overflow: elide;
                            }
                            // Alle Bildinformationen in einem Fenster links neben der Leiste, über dem Bild.
                            info-popup := PopupWindow {
                                x: -self.width - 24px;
                                y: 0;
                                width: 380px;
                                Rectangle {
                                    background: #2b2d31;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: #00000080;
                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 4px;
                                        Heading {
                                            text: root.info-title;
                                        }
                                        Rectangle {
                                            height: 4px;
                                        }
                                        for row in root.info-rows: HorizontalLayout {
                                            spacing: 10px;
                                            Text {
                                                width: 110px;
                                                text: row.label;
                                                color: #8a8f98;
                                                font-size: 12px;
                                            }
                                            Text {
                                                horizontal-stretch: 1;
                                                text: row.value;
                                                wrap: word-wrap;
                                                font-size: 12px;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if root.info-title != "": Text {
                            text: root.info-summary;
                            wrap: word-wrap;
                            color: #8a8f98;
                            font-size: 11px;
                        }

                        Heading {
                            text: "Auto-Korrektur";
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            CheckBox {
                                text: "Auto";
                                checked <=> root.auto-on;
                                enabled: root.controls-enabled;
                                toggled => {
                                    root.auto-toggled(self.checked);
                                    keys.focus();
                                }
                            }
                            Button {
                                text: "Zurücksetzen";
                                enabled: root.controls-enabled;
                                clicked => {
                                    root.reset();
                                    keys.focus();
                                }
                            }
                            // Pfeile selbst gezeichnet; ↶ ↷ zeigt Windows nicht zuverlässig.
                            IconButton {
                                commands: "M 5.5 2.5 L 2 6 L 5.5 9.5 M 2 6 L 10 6 C 12.5 6 14 7.8 14 10 C 14 12.2 12.5 14 10 14 L 6 14";
                                enabled: root.controls-enabled && root.can-undo;
                                clicked => {
                                    root.undo();
                                    keys.focus();
                                }
                            }
                            IconButton {
                                commands: "M 10.5 2.5 L 14 6 L 10.5 9.5 M 14 6 L 6 6 C 3.5 6 2 7.8 2 10 C 2 12.2 3.5 14 6 14 L 10 14";
                                enabled: root.controls-enabled && root.can-redo;
                                clicked => {
                                    root.redo();
                                    keys.focus();
                                }
                            }
                        }
                        // Presets: Menü zum Anwenden, daneben Speichern unter einem Namen.
                        HorizontalLayout {
                            spacing: 6px;
                            // Rahmen nur für das Menü; der Knopf füllt ihn, die Höhe gibt die Zeile vor
                            // (wie bei „Speichern …“ daneben).
                            Rectangle {
                                horizontal-stretch: 1;
                                min-height: preset-button.min-height;
                                preset-button := Button {
                                    width: parent.width;
                                    height: parent.height;
                                    text: root.selected-count > 1 ? "Preset auf " + root.selected-count + " Bilder …" : "Preset anwenden …";
                                    enabled: root.controls-enabled;
                                    clicked => {
                                        preset-menu.show();
                                    }
                                }
                                preset-menu := PopupWindow {
                                    x: 0;
                                    y: parent.height + 4px;
                                    width: 272px;
                                    Rectangle {
                                        background: #2b2d31;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: #00000080;
                                        VerticalLayout {
                                            padding: 6px;
                                            for preset[i] in root.presets: Rectangle {
                                                height: 30px;
                                                border-radius: 4px;
                                                background: preset-touch.has-hover ? Palette.accent-background.transparentize(0.8) : transparent;
                                                preset-touch := TouchArea {
                                                    clicked => {
                                                        root.apply-preset(i);
                                                        keys.focus();
                                                    }
                                                }
                                                HorizontalLayout {
                                                    padding-left: 8px;
                                                    padding-right: 8px;
                                                    spacing: 6px;
                                                    Text {
                                                        horizontal-stretch: 1;
                                                        text: preset.name;
                                                        vertical-alignment: center;
                                                        overflow: elide;
                                                    }
                                                    if preset.builtin: Text {
                                                        text: "mitgeliefert";
                                                        vertical-alignment: center;
                                                        color: #8a8f98;
                                                        font-size: 11px;
                                                    }
                                                    if !preset.builtin: Text {
                                                        text: "Löschen";
                                                        vertical-alignment: center;
                                                        color: delete-touch.has-hover ? #e5484d : #8a8f98;
                                                        font-size: 11px;
                                                        delete-touch := TouchArea {
                                                            clicked => {
                                                                root.delete-preset(i);
                                                                keys.focus();
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            Button {
                                text: "Speichern …";
                                enabled: root.controls-enabled;
                                clicked => {
                                    root.naming-preset = !root.naming-preset;
                                }
                            }
                        }
                        if root.naming-preset: HorizontalLayout {
                            spacing: 6px;
                            preset-name := LineEdit {
                                horizontal-stretch: 1;
                                placeholder-text: "Name des Presets";
                                init => {
                                    self.focus();
                                }
                                accepted(text) => {
                                    root.save-preset(text);
                                    root.naming-preset = false;
                                    keys.focus();
                                }
                            }
                            Button {
                                text: "OK";
                                clicked => {
                                    root.save-preset(preset-name.text);
                                    root.naming-preset = false;
                                    keys.focus();
                                }
                            }
                        }

                        SliderRow {
                            label: "Stärke";
                            text: round(root.v-strength) + " %";
                            minimum: 0;
                            maximum: 100;
                            value <=> root.v-strength;
                            enabled: root.controls-enabled;
                            field: "strength";
                            edited(f, v) => { root.edited(f, v); }
                            reset(f) => { root.reset-field(f); keys.focus(); }
                            released => { keys.focus(); }
                        }
                        Segmented {
                            options: ["Farbe", "Ton", "Details"];
                            selected: root.panel-tab;
                            changed(i) => {
                                root.panel-tab = i;
                                root.panel-tab-changed(i);
                                keys.focus();
                            }
                        }

                        panel := ScrollView {
                            vertical-stretch: 1;
                            content-width: self.visible-width;
                            content-height: controls.preferred-height;

                            controls := VerticalLayout {
                                width: panel.visible-width - 12px;
                                spacing: 8px;

                                if root.panel-tab == 0: VerticalLayout {
                                    spacing: 8px;
                                    SliderRow {
                                        label: "Rot wiederherstellen";
                                        text: round(root.v-hue) + "°";
                                        minimum: 0;
                                        maximum: 180;
                                        value <=> root.v-hue;
                                        enabled: root.controls-enabled;
                                        field: "hue";
                                        edited(f, v) => { root.edited(f, v); }
                                        reset(f) => { root.reset-field(f); keys.focus(); }
                                        released => { keys.focus(); }
                                    }
                                    SliderRow {
                                        label: "Temperatur";
                                        text: (root.v-temperature > 0.5 ? "+" : "") + round(root.v-temperature);
                                        minimum: -100;
                                        maximum: 100;
                                        value <=> root.v-temperature;
                                        enabled: root.controls-enabled;
                                        field: "temperature";
                                        edited(f, v) => { root.edited(f, v); }
                                        reset(f) => { root.reset-field(f); keys.focus(); }
                                        released => { keys.focus(); }
                                    }
                                    SliderRow {
                                        label: "Grün ↔ Magenta";
                                        text: (root.v-tint > 0.5 ? "+" : "") + round(root.v-tint);
                                        minimum: -100;
                                        maximum: 100;
                                        value <=> root.v-tint;
                                        enabled: root.controls-enabled;
                                        field: "tint";
                                        edited(f, v) => { root.edited(f, v); }
                                        reset(f) => { root.reset-field(f); keys.focus(); }
                                        released => { keys.focus(); }
                                    }
                                    Button {
                                        text: root.picking ? "Neutrale Stelle im Bild anklicken …" : "Pipette: Weißabgleich";
                                        checkable: true;
                                        checked <=> root.picking;
                                        enabled: root.controls-enabled;
                                    }
                                    SliderRow {
                                        label: "Dynamik";
                                        text: (root.v-vibrance > 0.5 ? "+" : "") + round(root.v-vibrance);
                                        minimum: -100;
                                        maximum: 100;
                                        value <=> root.v-vibrance;
                                        enabled: root.controls-enabled;
                                        field: "vibrance";
                                        edited(f, v) => { root.edited(f, v); }
                                        reset(f) => { root.reset-field(f); keys.focus(); }
                                        released => { keys.focus(); }
                                    }
                                    Rectangle {
                                        height: 4px;
                                    }
                                    Heading {
                                        text: "Farbmischer";
                                    }
                                    SliderRow {
                                        label: "Wasserfarbe";
                                        text: (root.v-water-hue > 0.5 ? "+" : "") + round(root.v-water-hue * 0.3) + "°";
                                        minimum: -100;
                                        maximum: 100;
                                        value <=> root.v-water-hue;
                                        enabled: root.controls-enabled;
                                        field: "water-hue";
                                        edited(f, v) => { root.edited(f, v); }
                                        reset(f) => { root.reset-field(f); keys.focus(); }
                                        released => { keys.focus(); }
                                    }
                                    SliderRow {
                                        label: "Wasser-Sättigung";
                                        text: (root.v-water-saturation > 0.5 ? "+" : "") + round(root.v-water-saturation);
                                        minimum: -100;
                                        maximum: 100;
                                        value <=> root.v-water-saturation;
                                        enabled: root.controls-enabled;
                                        field: "water-saturation";
                                        edited(f, v) => { root.edited(f, v); }
                                        reset(f) => { root.reset-field(f); keys.focus(); }
                                        released => { keys.focus(); }
                                    }
                                    SliderRow {
                                        label: "Fische/Korallen-Sättigung";
                                        text: (root.v-warm-saturation > 0.5 ? "+" : "") + round(root.v-warm-saturation);
                                        minimum: -100;
                                        maximum: 100;
                                        value <=> root.v-warm-saturation;
                                        enabled: root.controls-enabled;
                                        field: "warm-saturation";
                                        edited(f, v) => { root.edited(f, v); }
                                        reset(f) => { root.reset-field(f); keys.focus(); }
                                        released => { keys.focus(); }
                                    }
                                }

                                if root.panel-tab == 1: VerticalLayout {
                                    spacing: 8px;
                                    SliderRow {
                                        label: "Dunst entfernen";
                                        text: round(root.v-dehaze);
                                        minimum: 0;
                                        maximum: 100;
                                        value <=> root.v-dehaze;
                                        enabled: root.controls-enabled;
                                        field: "dehaze";
                                        edited(f, v) => { root.edited(f, v); }
                                        reset(f) => { root.reset-field(f); keys.focus(); }
                                        released => { keys.focus(); }
                                    }
                                    SliderRow {
                                        label: "Belichtung";
                                        text: (root.v-exposure > 2.5 ? "+" : "") + round(root.v-exposure / 5) / 10 + " EV";
                                        minimum: -100;
                                        maximum: 100;
                                        value <=> root.v-exposure;
                                        enabled: root.controls-enabled;
                                        field: "exposure";
                                        edited(f, v) => { root.edited(f, v); }
                                        reset(f) => { root.reset-field(f); keys.focus(); }
                                        released => { keys.focus(); }
                                    }
                                    SliderRow {
                                        label: "Kontrast";
                                        text: (root.v-contrast > 0.5 ? "+" : "") + round(root.v-contrast);
                                        minimum: -100;
                                        maximum: 100;
                                        value <=> root.v-contrast;
                                        enabled: root.controls-enabled;
                                        field: "contrast";
                                        edited(f, v) => { root.edited(f, v); }
                                        reset(f) => { root.reset-field(f); keys.focus(); }
                                        released => { keys.focus(); }
                                    }
                                    SliderRow {
                                        label: "Lichter";
                                        text: (root.v-highlights > 0.5 ? "+" : "") + round(root.v-highlights);
                                        minimum: -100;
                                        maximum: 100;
                                        value <=> root.v-highlights;
                                        enabled: root.controls-enabled;
                                        field: "highlights";
                                        edited(f, v) => { root.edited(f, v); }
                                        reset(f) => { root.reset-field(f); keys.focus(); }
                                        released => { keys.focus(); }
                                    }
                                    SliderRow {
                                        label: "Tiefen";
                                        text: (root.v-shadows > 0.5 ? "+" : "") + round(root.v-shadows);
                                        minimum: -100;
                                        maximum: 100;
                                        value <=> root.v-shadows;
                                        enabled: root.controls-enabled;
                                        field: "shadows";
                                        edited(f, v) => { root.edited(f, v); }
                                        reset(f) => { root.reset-field(f); keys.focus(); }
                                        released => { keys.focus(); }
                                    }
                                    SliderRow {
                                        label: "Vignette";
                                        text: (root.v-vignette > 0.5 ? "+" : "") + round(root.v-vignette);
                                        minimum: -100;
                                        maximum: 100;
                                        value <=> root.v-vignette;
                                        enabled: root.controls-enabled;
                                        field: "vignette";
                                        edited(f, v) => { root.edited(f, v); }
                                        reset(f) => { root.reset-field(f); keys.focus(); }
                                        released => { keys.focus(); }
                                    }
                                }

                                if root.panel-tab == 2: VerticalLayout {
                                    spacing: 8px;
                                    SliderRow {
                                        label: "Klarheit";
                                        text: (root.v-clarity > 0.5 ? "+" : "") + round(root.v-clarity);
                                        minimum: -100;
                                        maximum: 100;
                                        value <=> root.v-clarity;
                                        enabled: root.controls-enabled;
                                        field: "clarity";
                                        edited(f, v) => { root.edited(f, v); }
                                        reset(f) => { root.reset-field(f); keys.focus(); }
                                        released => { keys.focus(); }
                                    }
                                    // Eine Zeile: umbrochener Text zählt in der Höhe des Scrollbereichs nur
                                    // einzeilig, der letzte Regler ließe sich sonst nicht ganz hineinscrollen.
                                    Text {
                                        text: "Schärfen, Rauschen genau bei 100 % (Taste Z)";
                                        overflow: elide;
                                        color: #8a8f98;
                                        font-size: 11px;
                                    }
                                    SliderRow {
                                        label: "Schärfen";
                                        text: round(root.v-sharpen);
                                        minimum: 0;
                                        maximum: 100;
                                        value <=> root.v-sharpen;
                                        enabled: root.controls-enabled;
                                        field: "sharpen";
                                        edited(f, v) => { root.edited(f, v); }
                                        reset(f) => { root.reset-field(f); keys.focus(); }
                                        released => { keys.focus(); }
                                    }
                                    SliderRow {
                                        label: "Rauschen entfernen";
                                        text: round(root.v-noise);
                                        minimum: 0;
                                        maximum: 100;
                                        value <=> root.v-noise;
                                        enabled: root.controls-enabled;
                                        field: "noise";
                                        edited(f, v) => { root.edited(f, v); }
                                        reset(f) => { root.reset-field(f); keys.focus(); }
                                        released => { keys.focus(); }
                                    }
                                }
                            }
                        }

                        if root.selected-count > 1 || root.can-undo-transfer: Heading {
                            text: root.selected-count > 1 ? "Mehrere Bilder (" + root.selected-count + ")" : "Mehrere Bilder";
                        }
                        // Welche Gruppen übertragen werden; Zuschnitt ist standardmäßig aus.
                        if root.selected-count > 1: HorizontalLayout {
                            spacing: 6px;
                            SmallButton {
                                text: "Farbe";
                                active: root.transfer-color;
                                clicked => {
                                    root.transfer-color = !root.transfer-color;
                                    root.transfer-groups-changed();
                                    keys.focus();
                                }
                            }
                            SmallButton {
                                text: "Ton";
                                active: root.transfer-tone;
                                clicked => {
                                    root.transfer-tone = !root.transfer-tone;
                                    root.transfer-groups-changed();
                                    keys.focus();
                                }
                            }
                            SmallButton {
                                text: "Details";
                                active: root.transfer-detail;
                                clicked => {
                                    root.transfer-detail = !root.transfer-detail;
                                    root.transfer-groups-changed();
                                    keys.focus();
                                }
                            }
                            SmallButton {
                                text: "Zuschnitt";
                                active: root.transfer-geometry;
                                clicked => {
                                    root.transfer-geometry = !root.transfer-geometry;
                                    root.transfer-groups-changed();
                                    keys.focus();
                                }
                            }
                        }
                        if root.selected-count > 1: Button {
                            text: "Gleiche Werte übernehmen";
                            enabled: root.controls-enabled;
                            clicked => {
                                root.transfer-fixed();
                                keys.focus();
                            }
                        }
                        if root.selected-count > 1: Button {
                            text: "Auto + Abweichung übernehmen";
                            enabled: root.controls-enabled;
                            clicked => {
                                root.transfer-relative();
                                keys.focus();
                            }
                        }
                        if root.can-undo-transfer: Button {
                            text: "Letzte Übernahme rückgängig";
                            clicked => {
                                root.undo-transfer();
                                keys.focus();
                            }
                        }
                        Rectangle {
                            height: 1px;
                            background: #00000060;
                        }
                        if !root.exporting: HorizontalLayout {
                            spacing: 6px;
                            Button {
                                horizontal-stretch: 1;
                                text: "Aktuelles Bild exportieren (Strg+E)";
                                primary: true;
                                enabled: root.current >= 0;
                                clicked => {
                                    root.export-current();
                                    keys.focus();
                                }
                            }
                            // Export-Einstellungen; Dreieck wie bei der Programmauswahl darunter.
                            Rectangle {
                                width: 34px;
                                border-radius: 4px;
                                background: export-menu-touch.has-hover ? #ffffff26 : #ffffff12;
                                Path {
                                    x: (parent.width - 10px) / 2;
                                    y: (parent.height - 10px) / 2;
                                    width: 10px;
                                    height: 10px;
                                    viewbox-width: 10;
                                    viewbox-height: 10;
                                    commands: "M 0 2 L 10 2 L 5 8 Z";
                                    fill: #c8ccd2;
                                    stroke-width: 0px;
                                }
                                export-menu-touch := TouchArea {
                                    clicked => {
                                        export-menu.show();
                                    }
                                }
                                export-menu := PopupWindow {
                                    x: parent.width - 290px;
                                    y: -self.height - 6px;
                                    width: 290px;
                                    height: 150px;
                                    // Der Regler im Menü soll es beim Ziehen nicht schließen.
                                    close-policy: PopupClosePolicy.close-on-click-outside;
                                    Rectangle {
                                        background: #2b2d31;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: #00000080;
                                        VerticalLayout {
                                            padding: 12px;
                                            spacing: 8px;
                                            Heading {
                                                text: "Export-Einstellungen";
                                            }
                                            SliderRow {
                                                label: "JPG-Qualität";
                                                text: round(root.jpeg-quality);
                                                minimum: 50;
                                                maximum: 100;
                                                value <=> root.jpeg-quality;
                                                field: "jpeg-quality";
                                                edited(f, v) => { root.jpeg-quality-changed(v); }
                                                reset(f) => { root.jpeg-quality-changed(95); }
                                            }
                                            Text {
                                                text: "Ziel ist immer der Unterordner „uw-korrigiert“: gleicher Dateiname, EXIF und Farbprofil bleiben.";
                                                wrap: word-wrap;
                                                color: #8a8f98;
                                                font-size: 11px;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if !root.exporting && root.selected-count > 1: Button {
                            text: "Auswahl exportieren (" + root.selected-count + " Bilder)";
                            clicked => {
                                root.export-selection();
                                keys.focus();
                            }
                        }
                        if !root.exporting: HorizontalLayout {
                            spacing: 6px;
                            Button {
                                horizontal-stretch: 1;
                                text: "In " + root.open-with-name + " öffnen";
                                enabled: root.current >= 0;
                                clicked => {
                                    root.open-in-program();
                                    keys.focus();
                                }
                            }
                            // Programmauswahl; Dreieck selbst gezeichnet (siehe Bildinformationen).
                            Rectangle {
                                width: 34px;
                                border-radius: 4px;
                                background: menu-touch.has-hover ? #ffffff26 : #ffffff12;
                                Path {
                                    x: (parent.width - 10px) / 2;
                                    y: (parent.height - 10px) / 2;
                                    width: 10px;
                                    height: 10px;
                                    viewbox-width: 10;
                                    viewbox-height: 10;
                                    commands: "M 0 2 L 10 2 L 5 8 Z";
                                    fill: #c8ccd2;
                                    stroke-width: 0px;
                                }
                                menu-touch := TouchArea {
                                    clicked => {
                                        program-menu.show();
                                    }
                                }
                                program-menu := PopupWindow {
                                    x: parent.width - 290px;
                                    y: -(root.programs.length * 30px + 48px);
                                    width: 290px;
                                    Rectangle {
                                        background: #2b2d31;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: #00000080;
                                        VerticalLayout {
                                            padding: 6px;
                                            for program[i] in root.programs: Rectangle {
                                                height: 30px;
                                                border-radius: 4px;
                                                background: row-touch.has-hover ? Palette.accent-background.transparentize(0.8) : transparent;
                                                HorizontalLayout {
                                                    padding-left: 8px;
                                                    padding-right: 8px;
                                                    spacing: 6px;
                                                    Text {
                                                        width: 14px;
                                                        text: program.chosen ? "✓" : "";
                                                        vertical-alignment: center;
                                                        color: Palette.accent-background;
                                                    }
                                                    Text {
                                                        horizontal-stretch: 1;
                                                        text: program.name;
                                                        vertical-alignment: center;
                                                        color: program.found ? Palette.foreground : #8a8f98;
                                                    }
                                                    if !program.found: Text {
                                                        text: "nicht gefunden – suchen …";
                                                        vertical-alignment: center;
                                                        color: #8a8f98;
                                                        font-size: 11px;
                                                    }
                                                }
                                                row-touch := TouchArea {
                                                    clicked => {
                                                        root.choose-program(i);
                                                        keys.focus();
                                                    }
                                                }
                                            }
                                            Rectangle {
                                                height: 1px;
                                                background: #ffffff20;
                                            }
                                            Rectangle {
                                                height: 30px;
                                                border-radius: 4px;
                                                background: add-touch.has-hover ? Palette.accent-background.transparentize(0.8) : transparent;
                                                Text {
                                                    x: 28px;
                                                    text: "Anderes Programm hinzufügen …";
                                                    vertical-alignment: center;
                                                }
                                                add-touch := TouchArea {
                                                    clicked => {
                                                        root.add-program();
                                                        keys.focus();
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if root.exporting: Text {
                            text: root.export-progress;
                            font-size: 12px;
                        }
                        if root.exporting: Button {
                            text: "Export abbrechen";
                            clicked => {
                                root.cancel-export();
                                keys.focus();
                            }
                        }
                    }
                }
            }
        }

        if root.tip != "" && !root.library: Rectangle {
            x: 8px + 52px + 6px;
            y: root.tip-y - self.height / 2;
            width: tip-label.preferred-width + 18px;
            height: 26px;
            border-radius: 5px;
            background: #000000e0;
            tip-label := Text {
                text: root.tip;
                color: white;
                font-size: 12px;
            }
        }

        if root.show-help: Rectangle {
            background: #000000b0;
            TouchArea {
                clicked => {
                    root.show-help = false;
                }
            }
            Rectangle {
                width: min(parent.width - 80px, 760px);
                height: parent.height - 80px;
                border-radius: 8px;
                background: #25262a;
                border-width: 1px;
                border-color: #00000080;
                // Klicks im Hilfefenster schließen es nicht.
                TouchArea { }
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    HorizontalLayout {
                        Text {
                            horizontal-stretch: 1;
                            text: "Hilfe";
                            font-size: 20px;
                            font-weight: 700;
                        }
                        Button {
                            text: "Schließen (Esc)";
                            clicked => {
                                root.show-help = false;
                                keys.focus();
                            }
                        }
                    }
                    help-scroll := ScrollView {
                        vertical-stretch: 1;
                        content-width: self.visible-width;
                        content-height: help-body.preferred-height;
                        help-body := VerticalLayout {
                            width: help-scroll.visible-width - 14px;
                            spacing: 6px;
                            for section in root.help: VerticalLayout {
                                spacing: 4px;
                                padding-bottom: 10px;
                                Heading {
                                    text: section.title;
                                }
                                for line in section.lines: HorizontalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: "•";
                                        color: #8a8f98;
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: line;
                                        wrap: word-wrap;
                                        font-size: 12px;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
