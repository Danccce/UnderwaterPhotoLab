import { Button, CheckBox, Palette, ScrollView } from "std-widgets.slint";

export struct Thumb {
    image: image,
    name: string,
    loaded: bool,
    failed: bool,
    edited: bool,
    exported: bool,
    selected: bool,
    // Vorschaubild der exportierten Datei
    corrected: image,
    has-corrected: bool,
}

struct HelpSection {
    title: string,
    lines: [string],
}

export struct ProgramItem {
    name: string,
    found: bool,
    chosen: bool,
}

export struct InfoRow {
    label: string,
    value: string,
}

// Eigener Regler statt `Slider`, weil dessen Doppelklick nicht abzufangen ist.
component ValueSlider inherits Rectangle {
    in property <float> minimum;
    in property <float> maximum;
    in-out property <float> value;
    in property <bool> enabled: true;
    callback changed(float);
    callback released();
    callback double-clicked();
    height: 22px;

    property <length> knob: 16px;
    property <float> fraction: clamp((root.value - root.minimum) / (root.maximum - root.minimum), 0, 1);
    property <brush> accent: root.enabled ? Palette.accent-background : #5a5d65;

    function set-from(x: length) {
        root.value = clamp(root.minimum + (x - root.knob / 2) / (root.width - root.knob) * (root.maximum - root.minimum), root.minimum, root.maximum);
        root.changed(root.value);
    }

    Rectangle {
        y: (root.height - 4px) / 2;
        height: 4px;
        border-radius: 2px;
        background: #4a4d55;
    }
    Rectangle {
        x: 0;
        y: (root.height - 4px) / 2;
        width: (root.width - root.knob) * root.fraction + root.knob / 2;
        height: 4px;
        border-radius: 2px;
        background: root.accent;
    }
    Rectangle {
        x: (root.width - root.knob) * root.fraction;
        y: (root.height - root.knob) / 2;
        width: root.knob;
        height: root.knob;
        border-radius: root.knob / 2;
        background: root.accent;
        border-width: 2px;
        border-color: #1e1f22;
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.set-from(self.mouse-x);
            }
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                root.released();
            }
        }
        moved => {
            if self.pressed {
                root.set-from(self.mouse-x);
            }
        }
        double-clicked => {
            root.double-clicked();
        }
    }
}

component SliderRow inherits VerticalLayout {
    in property <string> label;
    in property <string> text;
    in property <string> field;
    in-out property <float> value;
    in property <float> minimum;
    in property <float> maximum;
    in property <bool> enabled: true;
    callback edited(string, float);
    callback reset(string);
    callback released();
    spacing: 0px;
    // Sonst wächst die Zeile in einer festen Spalte mit und Beschriftung und Regler rücken auseinander.
    vertical-stretch: 0;

    HorizontalLayout {
        Text {
            text: root.label;
            font-size: 12px;
            color: root.enabled ? Palette.foreground : #6b7078;
        }
        Text {
            text: root.text;
            font-size: 12px;
            horizontal-alignment: right;
            color: root.enabled ? #c8ccd2 : #6b7078;
        }
    }
    ValueSlider {
        minimum: root.minimum;
        maximum: root.maximum;
        value <=> root.value;
        enabled: root.enabled;
        changed(v) => {
            root.edited(root.field, v);
        }
        released => {
            root.released();
        }
        double-clicked => {
            root.reset(root.field);
        }
    }
}

// Umschalter aus gleich breiten Teilen: der gewählte ist hellblau hinterlegt.
component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> selected;
    callback changed(int);
    height: 26px;
    border-radius: 5px;
    border-width: 1px;
    border-color: #5a5d65;
    background: #2b2d31;
    clip: true;

    HorizontalLayout {
        for option[i] in root.options: Rectangle {
            horizontal-stretch: 1;
            background: i == root.selected ? #8cc4ff : touch.has-hover ? #ffffff14 : transparent;
            if i > 0: Rectangle {
                x: 0;
                width: 1px;
                background: #5a5d65;
            }
            Text {
                text: option;
                font-size: 12px;
                color: i == root.selected ? #0d2440 : Palette.foreground;
            }
            touch := TouchArea {
                clicked => {
                    if i != root.selected {
                        root.changed(i);
                    }
                }
            }
        }
    }
}

// Beschnitt-Dreieck in einer Ecke des Histogramms; gefüllt, wenn Kanäle beschnitten sind.
component ClipTriangle inherits TouchArea {
    in property <bool> right;
    in property <color> clipped;
    in property <bool> warning;
    width: 22px;
    height: 22px;
    mouse-cursor: MouseCursor.pointer;
    Path {
        x: root.right ? root.width - 16px : 4px;
        y: 4px;
        width: 12px;
        height: 12px;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: root.right ? "M 0 0 L 12 0 L 12 12 Z" : "M 0 0 L 12 0 L 0 12 Z";
        fill: root.clipped.alpha > 0 ? root.clipped : #ffffff22;
        stroke: root.warning ? white : #00000000;
        stroke-width: root.warning ? 1.5px : 0px;
    }
}

component Histogram inherits Rectangle {
    in property <string> red;
    in property <string> green;
    in property <string> blue;
    in property <color> clip-shadows;
    in property <color> clip-highlights;
    in property <bool> warning;
    callback toggled();
    border-radius: 4px;
    background: #18191c;
    clip: true;

    if root.red != "": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 256;
        viewbox-height: 100;
        commands: root.red;
        fill: #ff4a4a80;
        stroke-width: 0px;
    }
    if root.green != "": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 256;
        viewbox-height: 100;
        commands: root.green;
        fill: #45d16480;
        stroke-width: 0px;
    }
    if root.blue != "": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 256;
        viewbox-height: 100;
        commands: root.blue;
        fill: #4a8cff80;
        stroke-width: 0px;
    }
    ClipTriangle {
        x: 0;
        y: 0;
        clipped: root.clip-shadows;
        warning: root.warning;
        clicked => {
            root.toggled();
        }
    }
    ClipTriangle {
        x: root.width - self.width;
        y: 0;
        right: true;
        clipped: root.clip-highlights;
        warning: root.warning;
        clicked => {
            root.toggled();
        }
    }
}

// Kleiner Knopf mit selbst gezeichnetem Symbol (Pfad im Raster 16 × 16, nur Linien).
component IconButton inherits Rectangle {
    in property <string> commands;
    in property <bool> enabled: true;
    callback clicked();
    width: 32px;
    border-radius: 4px;
    background: touch.has-hover && root.enabled ? #ffffff26 : #ffffff12;
    Path {
        x: (parent.width - 16px) / 2;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: root.commands;
        stroke: root.enabled ? #c8ccd2 : #5a5d65;
        stroke-width: 1.6px;
        fill: transparent;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            root.clicked();
        }
    }
}

component Heading inherits Text {
    font-weight: 700;
    font-size: 13px;
}

component Tag inherits Rectangle {
    in property <string> text;
    height: 24px;
    width: label.preferred-width + 16px;
    border-radius: 4px;
    background: #000000a0;
    label := Text {
        text: root.text;
        color: white;
        font-size: 12px;
    }
}

export component LabWindow inherits Window {
    title: "UnderwaterPhotoLab";
    preferred-width: 1200px;
    preferred-height: 780px;
    min-width: 960px;
    min-height: 620px;
    forward-focus: keys;

    in property <[Thumb]> thumbs;
    in-out property <int> current: -1;
    in property <string> folder;
    in property <string> status;
    // Bildinformationen: in der Leiste die Zusammenfassung, im Fenster am Dateinamen alle Zeilen.
    in property <string> info-title;
    in property <string> info-summary;
    in property <[InfoRow]> info-rows;
    in property <bool> drag-over;
    in property <image> preview-original;
    in property <image> preview-corrected;
    in property <bool> has-preview;
    in property <bool> loading;
    in-out property <bool> split;
    in-out property <float> split-pos: 0.5;

    // Histogramm der korrigierten Vorschau: SVG-Pfade im Raster 256 × 100 aus Rust.
    in property <string> hist-red;
    in property <string> hist-green;
    in property <string> hist-blue;
    // Farbe der Beschnitt-Dreiecke; durchsichtig, wenn nichts beschnitten ist.
    in property <color> clip-shadows;
    in property <color> clip-highlights;
    // Taste J oder Klick auf ein Dreieck: beschnittene Stellen im Bild markieren.
    in-out property <bool> clip-warning;
    callback clip-warning-changed();

    // Zoom: Doppelklick oder Z auf 100 %, Mausrad oder Pinch stufenlos. Rust rechnet den Ausschnitt
    // `zoom-x/-y/-w/-h` (Bildpixel) des ganzen Bildes; `zoom-cx/-cy` ist die gewünschte Mitte in
    // Bildpixeln, `zoom-scale` sind Bildschirmpixel je Bildpixel (1 = 100 %).
    in-out property <bool> zoomed;
    in-out property <float> zoom-scale: 1;
    in-out property <float> zoom-cx;
    in-out property <float> zoom-cy;
    in property <float> full-width: 1;
    in property <float> full-height: 1;
    in property <image> zoom-original;
    in property <image> zoom-corrected;
    in property <float> zoom-x;
    in property <float> zoom-y;
    in property <float> zoom-w;
    in property <float> zoom-h;
    // Setzt Rust bei jedem Scrollen: Touchpad schiebt, Mausrad zoomt.
    in property <bool> wheel-from-touchpad;
    out property <float> view-w: preview-box.width / 1phx;
    out property <float> view-h: preview-box.height / 1phx;
    callback zoom-changed();
    property <length> fit: min(preview-box.width / root.full-width, preview-box.height / root.full-height);
    property <float> fit-scale: root.fit / 1phx;
    property <float> max-scale: 4;
    // Bildstelle unter dem Mauszeiger, die beim Zoomen stehen bleibt.
    property <float> anchor-x;
    property <float> anchor-y;

    // Hält die Mitte so, dass der Ausschnitt im Bild bleibt; kleinere Bilder stehen mittig.
    public function set-center(x: float, y: float) {
        root.zoom-cx = root.full-width * root.zoom-scale <= root.view-w ? root.full-width / 2
            : clamp(x, root.view-w / 2 / root.zoom-scale, root.full-width - root.view-w / 2 / root.zoom-scale);
        root.zoom-cy = root.full-height * root.zoom-scale <= root.view-h ? root.full-height / 2
            : clamp(y, root.view-h / 2 / root.zoom-scale, root.full-height - root.view-h / 2 / root.zoom-scale);
    }
    // Mausposition im Vorschaufeld → Bildpixel, in beiden Ansichten.
    pure function image-x(mx: length) -> float {
        root.zoomed ? root.zoom-cx + (mx - preview-box.width / 2) / 1phx / root.zoom-scale
            : (mx - (preview-box.width - root.full-width * root.fit) / 2) / root.fit
    }
    pure function image-y(my: length) -> float {
        root.zoomed ? root.zoom-cy + (my - preview-box.height / 2) / 1phx / root.zoom-scale
            : (my - (preview-box.height - root.full-height * root.fit) / 2) / root.fit
    }
    // Während des Ladens ist die Bildgröße noch unbekannt; dann zentriert Rust nach dem Laden.
    in-out property <bool> center-on-load;
    // Zoomt auf `scale`, die Bildstelle unter (mx, my) bleibt stehen; bis zum eingepassten Bild
    // zurück beendet den Zoom.
    function zoom-to(scale: float, mx: length, my: length) {
        if root.loading {
            root.center-on-load = true;
            root.zoom-scale = min(scale, root.max-scale);
            root.zoomed = true;
            root.zoom-changed();
        } else if scale <= root.fit-scale * 1.01 {
            root.zoomed = false;
        } else {
            root.anchor-x = root.image-x(mx);
            root.anchor-y = root.image-y(my);
            root.zoom-scale = min(scale, root.max-scale);
            root.zoomed = true;
            root.set-center(root.anchor-x - (mx - preview-box.width / 2) / 1phx / root.zoom-scale,
                root.anchor-y - (my - preview-box.height / 2) / 1phx / root.zoom-scale);
            root.zoom-changed();
        }
    }
    changed view-w => {
        if root.zoomed {
            root.set-center(root.zoom-cx, root.zoom-cy);
            root.zoom-changed();
        }
    }
    changed view-h => {
        if root.zoomed {
            root.set-center(root.zoom-cx, root.zoom-cy);
            root.zoom-changed();
        }
    }

    callback open-folder();
    // Klick in der Leiste: Index, Strg gedrückt, Umschalt gedrückt.
    callback thumb-pressed(int, bool, bool);
    callback navigate(int);
    callback select-all();
    callback clear-selection();

    in property <int> selected-count;
    in property <bool> can-undo-transfer;
    callback transfer-fixed();
    callback transfer-relative();
    callback undo-transfer();

    in-out property <float> jpeg-quality: 95;
    in property <bool> exporting;
    in property <string> export-progress;
    callback export-current();
    callback export-selection();
    callback cancel-export();
    callback jpeg-quality-changed(float);

    // „In … öffnen“
    in property <[ProgramItem]> programs;
    in property <string> open-with-name;
    callback open-in-program();
    callback choose-program(int);
    callback add-program();

    // Hilfe (F1 oder „?“); Inhalt wie docs/HILFE.md.
    property <bool> show-help;
    property <[HelpSection]> help: [
        {
            title: "Bilder auswählen und vergleichen",
            lines: [
                "Ordner öffnen: Knopf links in der Leiste, Ordner oder Bild ins Fenster ziehen, oder Ordner auf die .exe ziehen. Beim nächsten Start öffnet sich der zuletzt geöffnete Ordner.",
                "Bild wechseln: Klick in die Leiste oder Pfeiltasten ← →.",
                "Original zeigen: Knopf „Original“ unter dem Bild oder Leertaste gedrückt halten.",
                "Split-Ansicht: Knopf „Split-Ansicht“ unter dem Bild oder Taste S; die Trennlinie mit der Maus ziehen.",
                "Zoom: Doppelklick ins Bild (100 % an dieser Stelle) oder Taste Z; Mausrad oder zwei Finger auf- und zuziehen (Touchpad, Touchbildschirm) zoomt stufenlos bis 400 %. Ziehen oder zwei Finger schieben verschiebt den Ausschnitt. Doppelklick, Z oder Esc zurück.",
                "Bildinformationen: oben rechts auf den Dateinamen klicken; ein Fenster mit allen Angaben öffnet sich, ein Klick daneben schließt es.",
            ],
        },
        {
            title: "Korrigieren",
            lines: [
                "Die Auto-Korrektur stellt Rot wieder her und spreizt die Farbkanäle für jedes Bild einzeln.",
                "Histogramm oben rechts: Rot-, Grün- und Blaukanal des korrigierten Bildes. Die Dreiecke leuchten, wenn Tiefen (links) oder Lichter (rechts) beschnitten werden, in der Farbe der betroffenen Kanäle.",
                "Klick auf ein Dreieck oder Taste J: beschnittene Stellen im Bild markieren (rot = Lichter, blau = Tiefen).",
                "Stärke: wie stark die Korrektur wirkt (0 % = Original).",
                "Der Umschalter „Farbe | Ton | Details“ unter der Stärke zeigt die jeweilige Reglergruppe; die Einstellungen der anderen Gruppen bleiben wirksam.",
                "Temperatur und Grün ↔ Magenta: Reststich ausgleichen.",
                "Pipette: Knopf drücken, dann eine eigentlich neutrale Stelle anklicken (Sand, Flosse, Graukarte).",
                "Dynamik: schwache Farben kräftiger, kräftige bleiben.",
                "Rot-Obergrenze: begrenzt, wie stark der Rotkanal angehoben wird (weniger Rauschen).",
                "Dunst entfernen: nimmt den Schleier aus Schwebeteilchen heraus; die Wasserfarbe wird aus dem ganzen Bild geschätzt. Das Bild wird dabei oft dunkler – mit Belichtung oder Tiefen ausgleichen.",
                "Belichtung: ±2 Blenden. Kontrast: S-Kurve, Schwarz und Weiß bleiben.",
                "Lichter: helle Bereiche dunkler (−) oder heller (+). Tiefen: dunkle Bereiche heller (+) oder dunkler (−). Wirkt nach der Helligkeit der Umgebung, Details bleiben erhalten.",
                "Doppelklick auf einen Regler setzt nur diesen zurück; „Zurücksetzen“ setzt alle zurück.",
                "Rückgängig: Strg+Z oder Pfeil nach links neben „Zurücksetzen“; Wiederholen: Strg+Y (oder Strg+Umschalt+Z) bzw. Pfeil nach rechts. Jedes Bild hat seinen eigenen Verlauf; ein Zug an einem Regler ist ein Schritt.",
            ],
        },
        {
            title: "Mehrere Bilder",
            lines: [
                "Strg+Klick: Bild dazu oder weg. Umschalt+Klick: Bereich. Strg+A: alle. Esc: Auswahl aufheben.",
                "Übernommen werden die Einstellungen des blau umrandeten Bildes.",
                "„Gleiche Werte übernehmen“: jedes Bild bekommt genau dieselbe Korrektur – für eine Serie aus derselben Situation.",
                "„Auto + Abweichung übernehmen“: jedes Bild behält seine Auto-Analyse, deine Änderungen kommen dazu.",
                "„Letzte Übernahme rückgängig“ gilt, bis ein Regler bewegt wird.",
            ],
        },
        {
            title: "Export und Weiterbearbeiten",
            lines: [
                "Export (Strg+E, Auswahl Strg+Umschalt+E) in den Unterordner „uw-korrigiert“: gleicher Dateiname, EXIF und Farbprofil bleiben.",
                "JPG-Qualität: Pfeil rechts neben „Aktuelles Bild exportieren“.",
                "Originale werden nie verändert; ein erneuter Export ersetzt das vorherige Ergebnis.",
                "Leiste: ✓ = mit den jetzigen Einstellungen exportiert, ● = bearbeitet.",
                "Leiste „Korrigiert“: exportierte Bilder erscheinen korrigiert, alle anderen als Original.",
                "„In … öffnen“ exportiert Fehlendes zuerst und übergibt die Bilder dem Programm; der Pfeil daneben wechselt das Programm.",
                "RapidRaw öffnet bei mehreren Bildern nur eines. Lightroom Classic zeigt den Import-Dialog, LightCraft importiert in seine Bibliothek.",
                "Einstellungen jedes Bildes stehen in „uw-korrigiert\\.uwcc.json“ und sind beim nächsten Öffnen wieder da.",
            ],
        },
        {
            title: "Herkunft",
            lines: [
                "Auto-Korrektur nach „underwater-image-color-correction“ von Nikolaj Bech Andersen (GPL-3.0), github.com/nikolajbech/underwater-image-color-correction.",
            ],
        },
    ];

    // Leiste zeigt exportierte Bilder korrigiert; alle anderen bleiben Original.
    in-out property <bool> strip-corrected;
    callback strip-mode-changed(bool);

    // Regler zeigen die wirksamen Werte; Rust schreibt sie nach jeder Änderung zurück.
    in-out property <bool> auto-on: true;
    in-out property <float> v-strength: 100;
    in-out property <float> v-hue;
    in-out property <float> v-temperature;
    in-out property <float> v-tint;
    in-out property <float> v-vibrance;
    in-out property <float> v-red-limit: 4;
    in-out property <float> v-exposure;
    in-out property <float> v-contrast;
    in-out property <float> v-highlights;
    in-out property <float> v-shadows;
    in-out property <float> v-dehaze;
    // Reglergruppe unter dem Umschalter: 0 Farbe, 1 Ton, 2 Details.
    in-out property <int> panel-tab;
    in-out property <bool> picking;
    property <bool> controls-enabled: root.has-preview && !root.loading;

    callback edited(string, float);
    callback auto-toggled(bool);
    callback reset();
    // Rückgängig/Wiederholen der Einstellungen des aktuellen Bildes.
    in property <bool> can-undo;
    in property <bool> can-redo;
    callback undo();
    callback redo();
    callback reset-field(string);
    // Pipette: Klickposition als Anteil von Bildbreite und -höhe (0–1).
    callback pick(float, float);

    property <length> cell-width: 132px;
    property <length> cell-gap: 8px;
    property <bool> space-held;
    // Leertaste oder „Vorher“-Knopf: das ganze Bild als Original, auch in der Split-Ansicht.
    property <bool> hold: root.space-held || before-button.pressed;
    property <float> original-fraction: root.hold ? 1 : (root.split ? root.split-pos : 0);
    property <length> current-left: root.cell-gap + root.current * (root.cell-width + root.cell-gap);

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    // Das gewählte Bild in der Leiste sichtbar halten (Pfeiltasten, neuer Ordner).
    changed current => {
        if root.current >= 0 {
            if root.current-left + strip.content-x < 0 {
                strip.content-x = root.cell-gap - root.current-left;
            } else if root.current-left + root.cell-width + strip.content-x > strip.visible-width {
                strip.content-x = strip.visible-width - root.current-left - root.cell-width - root.cell-gap;
            }
        }
    }

    keys := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            if event.text == Key.F1 {
                root.show-help = !root.show-help;
                return accept;
            }
            if root.show-help && event.text == Key.Escape {
                root.show-help = false;
                return accept;
            }
            if root.zoomed && event.text == Key.Escape {
                root.zoomed = false;
                return accept;
            }
            if event.modifiers.control && (event.text == "z" || event.text == "Z") {
                if event.modifiers.shift {
                    root.redo();
                } else {
                    root.undo();
                }
                return accept;
            }
            if event.modifiers.control && (event.text == "y" || event.text == "Y") {
                root.redo();
                return accept;
            }
            if (event.text == "z" || event.text == "Z") && !event.modifiers.control && root.has-preview {
                if root.zoomed {
                    root.zoomed = false;
                } else {
                    root.zoom-to(1, preview-box.width / 2, preview-box.height / 2);
                }
                return accept;
            }
            if event.text == " " {
                root.space-held = true;
                return accept;
            }
            if event.text == Key.LeftArrow {
                root.navigate(-1);
                return accept;
            }
            if event.text == Key.RightArrow {
                root.navigate(1);
                return accept;
            }
            if event.modifiers.control && (event.text == "e" || event.text == "E") && !root.exporting {
                if event.modifiers.shift && root.selected-count > 1 {
                    root.export-selection();
                } else {
                    root.export-current();
                }
                return accept;
            }
            if event.modifiers.control && (event.text == "a" || event.text == "A") {
                root.select-all();
                return accept;
            }
            if event.text == Key.Escape {
                root.clear-selection();
                return accept;
            }
            if (event.text == "s" || event.text == "S") && root.has-preview {
                root.split = !root.split;
                return accept;
            }
            if (event.text == "j" || event.text == "J") && root.has-preview {
                root.clip-warning = !root.clip-warning;
                root.clip-warning-changed();
                return accept;
            }
            reject
        }
        key-released(event) => {
            if event.text == " " {
                root.space-held = false;
                return accept;
            }
            reject
        }
        changed has-focus => {
            if !self.has-focus {
                root.space-held = false;
            }
        }

        VerticalLayout {
            // Trennlinie zur Titelleiste, die dieselbe Farbe wie die Reglerleiste hat.
            Rectangle {
                height: 1px;
                background: #00000060;
            }
            HorizontalLayout {
                vertical-stretch: 1;

                // Vorschau: unten das bearbeitete Bild, darüber das Original bis `original-fraction`.
                preview-box := Rectangle {
                    horizontal-stretch: 1;
                    background: #141518;
                    clip: true;

                    if root.has-preview && !root.zoomed: Image {
                        width: 100%;
                        height: 100%;
                        source: root.preview-corrected;
                        image-fit: contain;
                    }
                    // Zoom: Ausschnitt maßstabsgerecht; über 100 % pixelgenau vergrößert.
                    if root.has-preview && root.zoomed: Image {
                        x: preview-box.width / 2 + (root.zoom-x - root.zoom-cx) * root.zoom-scale * 1phx;
                        y: preview-box.height / 2 + (root.zoom-y - root.zoom-cy) * root.zoom-scale * 1phx;
                        width: root.zoom-w * root.zoom-scale * 1phx;
                        height: root.zoom-h * root.zoom-scale * 1phx;
                        source: root.zoom-corrected;
                        image-rendering: root.zoom-scale > 1.01 ? ImageRendering.pixelated : ImageRendering.smooth;
                    }
                    if root.has-preview && root.original-fraction > 0: Rectangle {
                        x: 0;
                        y: 0;
                        width: preview-box.width * root.original-fraction;
                        height: 100%;
                        clip: true;
                        if !root.zoomed: Image {
                            x: 0;
                            y: 0;
                            width: preview-box.width;
                            height: preview-box.height;
                            source: root.preview-original;
                            image-fit: contain;
                        }
                        if root.zoomed: Image {
                            x: preview-box.width / 2 + (root.zoom-x - root.zoom-cx) * root.zoom-scale * 1phx;
                            y: preview-box.height / 2 + (root.zoom-y - root.zoom-cy) * root.zoom-scale * 1phx;
                            width: root.zoom-w * root.zoom-scale * 1phx;
                            height: root.zoom-h * root.zoom-scale * 1phx;
                            source: root.zoom-original;
                            image-rendering: root.zoom-scale > 1.01 ? ImageRendering.pixelated : ImageRendering.smooth;
                        }
                    }
                    if root.has-preview && root.split && !root.hold: Rectangle {
                        x: preview-box.width * root.split-pos - 1px;
                        width: 2px;
                        height: 100%;
                        background: white;
                    }
                    if root.has-preview && root.split && !root.hold: Rectangle {
                        x: preview-box.width * root.split-pos - 14px;
                        y: preview-box.height / 2 - 14px;
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        background: white;
                        // Zwei Dreiecke selbst gezeichnet; Schriftzeichen sitzen nicht mittig.
                        Path {
                            width: 100%;
                            height: 100%;
                            viewbox-width: 28;
                            viewbox-height: 28;
                            commands: "M 11.5 8.5 L 5 14 L 11.5 19.5 Z M 16.5 8.5 L 23 14 L 16.5 19.5 Z";
                            fill: #2a7fff;
                            stroke-width: 0px;
                        }
                    }
                    if root.has-preview && root.split && !root.hold: Tag {
                        x: 12px;
                        y: 12px;
                        text: "Original";
                    }
                    if root.has-preview && root.split && !root.hold: Tag {
                        x: preview-box.width - self.width - 12px;
                        y: 12px;
                        text: "Korrigiert";
                    }
                    if root.has-preview && root.hold: Tag {
                        x: 12px;
                        y: 12px;
                        text: "Original";
                    }
                    if root.loading || (root.zoomed && root.zoom-corrected.width == 0): Tag {
                        x: (preview-box.width - self.width) / 2;
                        y: 12px;
                        text: "Lade …";
                    }
                    if root.has-preview && root.zoomed: Tag {
                        x: 12px;
                        y: preview-box.height - self.height - 12px;
                        text: round(root.zoom-scale * 100) + " %";
                    }
                    if !root.has-preview: Text {
                        text: root.thumbs.length == 0 ? "Ordner öffnen oder hierher ziehen" : "Bild in der Leiste auswählen";
                        color: #8a8f98;
                        font-size: 20px;
                    }
                    if root.drag-over: Rectangle {
                        border-width: 3px;
                        border-color: #2a7fff;
                        background: #2a7fff22;
                    }

                    // Ohne Zoom verschiebt jeder Klick die Split-Linie; mit Zoom nur ein Griff an der
                    // Linie, sonst verschiebt Ziehen den Ausschnitt.
                    TouchArea {
                        property <bool> panning;
                        property <bool> splitting;
                        property <length> start-x;
                        property <length> start-y;
                        property <float> start-cx;
                        property <float> start-cy;
                        property <bool> on-split: root.has-preview && root.split && !root.hold
                            && (!root.zoomed || abs(self.mouse-x - preview-box.width * root.split-pos) < 12px);
                        mouse-cursor: root.picking ? MouseCursor.crosshair
                            : self.on-split || self.splitting ? MouseCursor.ew-resize
                            : self.panning ? MouseCursor.move
                            : MouseCursor.default;
                        pointer-event(event) => {
                            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                keys.focus();
                                if root.picking {
                                    root.picking = false;
                                    root.pick(root.image-x(self.mouse-x) / root.full-width, root.image-y(self.mouse-y) / root.full-height);
                                } else if self.on-split {
                                    self.splitting = true;
                                    root.split-pos = clamp(self.mouse-x / self.width, 0, 1);
                                } else if root.zoomed {
                                    self.panning = true;
                                    self.start-x = self.mouse-x;
                                    self.start-y = self.mouse-y;
                                    self.start-cx = root.zoom-cx;
                                    self.start-cy = root.zoom-cy;
                                }
                            }
                            // Beginnt eine Zwei-Finger-Geste, bricht Slint das Ziehen mit `cancel` ab.
                            if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                                self.panning = false;
                                self.splitting = false;
                            }
                        }
                        moved => {
                            if self.splitting {
                                root.split-pos = clamp(self.mouse-x / self.width, 0, 1);
                            } else if self.panning {
                                root.set-center(self.start-cx - (self.mouse-x - self.start-x) / 1phx / root.zoom-scale,
                                    self.start-cy - (self.mouse-y - self.start-y) / 1phx / root.zoom-scale);
                                root.zoom-changed();
                            }
                        }
                        // Mausrad und Pinch (kommt unter Windows als Strg+Rad) zoomen um den
                        // Mauszeiger; zwei Finger auf dem Touchpad verschieben den Ausschnitt.
                        scroll-event(event) => {
                            if !root.has-preview || root.loading || root.picking {
                                return reject;
                            }
                            if event.modifiers.control || !root.wheel-from-touchpad {
                                root.zoom-to((root.zoomed ? root.zoom-scale : root.fit-scale) * pow(1.004, event.delta-y / 1px), self.mouse-x, self.mouse-y);
                                return accept;
                            }
                            if root.zoomed {
                                root.set-center(root.zoom-cx - event.delta-x / 1phx / root.zoom-scale, root.zoom-cy - event.delta-y / 1phx / root.zoom-scale);
                                root.zoom-changed();
                                return accept;
                            }
                            reject
                        }
                        double-clicked => {
                            if root.has-preview && !root.picking {
                                if root.zoomed {
                                    root.zoomed = false;
                                } else {
                                    root.zoom-to(1, self.mouse-x, self.mouse-y);
                                }
                            }
                        }
                    }
                    // Zwei Finger auf dem Touchbildschirm: auseinanderziehen zoomt um den Mittelpunkt,
                    // gemeinsam schieben verschiebt. Liegt über der TouchArea und lässt alles andere durch.
                    ScaleRotateGestureHandler {
                        property <float> start-scale;
                        property <length> last-x;
                        property <length> last-y;
                        enabled: root.has-preview && !root.loading;
                        started => {
                            self.start-scale = root.zoomed ? root.zoom-scale : root.fit-scale;
                            self.last-x = self.center.x;
                            self.last-y = self.center.y;
                        }
                        updated => {
                            root.zoom-to(self.start-scale * self.scale, self.center.x, self.center.y);
                            if root.zoomed {
                                root.set-center(root.zoom-cx - (self.center.x - self.last-x) / 1phx / root.zoom-scale,
                                    root.zoom-cy - (self.center.y - self.last-y) / 1phx / root.zoom-scale);
                                root.zoom-changed();
                            }
                            self.last-x = self.center.x;
                            self.last-y = self.center.y;
                        }
                    }
                }

                // Reglerleiste
                Rectangle {
                    width: 300px;
                    background: Palette.alternate-background;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;

                        Histogram {
                            height: 96px;
                            red: root.hist-red;
                            green: root.hist-green;
                            blue: root.hist-blue;
                            clip-shadows: root.clip-shadows;
                            clip-highlights: root.clip-highlights;
                            warning: root.clip-warning;
                            toggled => {
                                if root.has-preview {
                                    root.clip-warning = !root.clip-warning;
                                    root.clip-warning-changed();
                                }
                                keys.focus();
                            }
                        }

                        // Fest stehen Bildinfo, Auto-Korrektur, Stärke und Umschalter; nur die Regler der
                        // gewählten Gruppe scrollen.
                        if root.info-title != "": TouchArea {
                            height: info-heading.preferred-height;
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                info-popup.show();
                            }
                            // Dreieck selbst gezeichnet: Windows zeigt ◀ sonst als Emoji.
                            Path {
                                x: 0;
                                y: (parent.height - 10px) / 2;
                                width: 10px;
                                height: 10px;
                                viewbox-width: 10;
                                viewbox-height: 10;
                                commands: "M 8 0 L 2 5 L 8 10 Z";
                                fill: #c8ccd2;
                                stroke-width: 0px;
                            }
                            info-heading := Heading {
                                x: 16px;
                                width: parent.width - 16px;
                                text: root.info-title;
                                overflow: elide;
                            }
                            // Alle Bildinformationen in einem Fenster links neben der Leiste, über dem Bild.
                            info-popup := PopupWindow {
                                x: -self.width - 24px;
                                y: 0;
                                width: 380px;
                                Rectangle {
                                    background: #2b2d31;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: #00000080;
                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 4px;
                                        Heading {
                                            text: root.info-title;
                                        }
                                        Rectangle {
                                            height: 4px;
                                        }
                                        for row in root.info-rows: HorizontalLayout {
                                            spacing: 10px;
                                            Text {
                                                width: 110px;
                                                text: row.label;
                                                color: #8a8f98;
                                                font-size: 12px;
                                            }
                                            Text {
                                                horizontal-stretch: 1;
                                                text: row.value;
                                                wrap: word-wrap;
                                                font-size: 12px;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if root.info-title != "": Text {
                            text: root.info-summary;
                            wrap: word-wrap;
                            color: #8a8f98;
                            font-size: 11px;
                        }

                        Heading {
                            text: "Auto-Korrektur";
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            CheckBox {
                                text: "Auto";
                                checked <=> root.auto-on;
                                enabled: root.controls-enabled;
                                toggled => {
                                    root.auto-toggled(self.checked);
                                    keys.focus();
                                }
                            }
                            Button {
                                text: "Zurücksetzen";
                                enabled: root.controls-enabled;
                                clicked => {
                                    root.reset();
                                    keys.focus();
                                }
                            }
                            // Pfeile selbst gezeichnet; ↶ ↷ zeigt Windows nicht zuverlässig.
                            IconButton {
                                commands: "M 5.5 2.5 L 2 6 L 5.5 9.5 M 2 6 L 10 6 C 12.5 6 14 7.8 14 10 C 14 12.2 12.5 14 10 14 L 6 14";
                                enabled: root.controls-enabled && root.can-undo;
                                clicked => {
                                    root.undo();
                                    keys.focus();
                                }
                            }
                            IconButton {
                                commands: "M 10.5 2.5 L 14 6 L 10.5 9.5 M 14 6 L 6 6 C 3.5 6 2 7.8 2 10 C 2 12.2 3.5 14 6 14 L 10 14";
                                enabled: root.controls-enabled && root.can-redo;
                                clicked => {
                                    root.redo();
                                    keys.focus();
                                }
                            }
                        }
                        SliderRow {
                            label: "Stärke";
                            text: round(root.v-strength) + " %";
                            minimum: 0;
                            maximum: 100;
                            value <=> root.v-strength;
                            enabled: root.controls-enabled;
                            field: "strength";
                            edited(f, v) => { root.edited(f, v); }
                            reset(f) => { root.reset-field(f); keys.focus(); }
                            released => { keys.focus(); }
                        }
                        Segmented {
                            options: ["Farbe", "Ton", "Details"];
                            selected: root.panel-tab;
                            changed(i) => {
                                root.panel-tab = i;
                                keys.focus();
                            }
                        }

                        panel := ScrollView {
                            vertical-stretch: 1;
                            content-width: self.visible-width;
                            content-height: controls.preferred-height;

                            controls := VerticalLayout {
                                width: panel.visible-width - 12px;
                                spacing: 8px;

                                if root.panel-tab == 0: VerticalLayout {
                                    spacing: 8px;
                                    SliderRow {
                                        label: "Rot wiederherstellen";
                                        text: round(root.v-hue) + "°";
                                        minimum: 0;
                                        maximum: 180;
                                        value <=> root.v-hue;
                                        enabled: root.controls-enabled;
                                        field: "hue";
                                        edited(f, v) => { root.edited(f, v); }
                                        reset(f) => { root.reset-field(f); keys.focus(); }
                                        released => { keys.focus(); }
                                    }
                                    SliderRow {
                                        label: "Temperatur";
                                        text: (root.v-temperature > 0.5 ? "+" : "") + round(root.v-temperature);
                                        minimum: -100;
                                        maximum: 100;
                                        value <=> root.v-temperature;
                                        enabled: root.controls-enabled;
                                        field: "temperature";
                                        edited(f, v) => { root.edited(f, v); }
                                        reset(f) => { root.reset-field(f); keys.focus(); }
                                        released => { keys.focus(); }
                                    }
                                    SliderRow {
                                        label: "Grün ↔ Magenta";
                                        text: (root.v-tint > 0.5 ? "+" : "") + round(root.v-tint);
                                        minimum: -100;
                                        maximum: 100;
                                        value <=> root.v-tint;
                                        enabled: root.controls-enabled;
                                        field: "tint";
                                        edited(f, v) => { root.edited(f, v); }
                                        reset(f) => { root.reset-field(f); keys.focus(); }
                                        released => { keys.focus(); }
                                    }
                                    Button {
                                        text: root.picking ? "Neutrale Stelle im Bild anklicken …" : "Pipette: Weißabgleich";
                                        checkable: true;
                                        checked <=> root.picking;
                                        enabled: root.controls-enabled;
                                    }
                                    SliderRow {
                                        label: "Dynamik";
                                        text: (root.v-vibrance > 0.5 ? "+" : "") + round(root.v-vibrance);
                                        minimum: -100;
                                        maximum: 100;
                                        value <=> root.v-vibrance;
                                        enabled: root.controls-enabled;
                                        field: "vibrance";
                                        edited(f, v) => { root.edited(f, v); }
                                        reset(f) => { root.reset-field(f); keys.focus(); }
                                        released => { keys.focus(); }
                                    }
                                    SliderRow {
                                        label: "Rot-Obergrenze";
                                        text: "× " + round(root.v-red-limit * 10) / 10;
                                        minimum: 1;
                                        maximum: 8;
                                        value <=> root.v-red-limit;
                                        enabled: root.controls-enabled;
                                        field: "red-limit";
                                        edited(f, v) => { root.edited(f, v); }
                                        reset(f) => { root.reset-field(f); keys.focus(); }
                                        released => { keys.focus(); }
                                    }
                                }

                                if root.panel-tab == 1: VerticalLayout {
                                    spacing: 8px;
                                    SliderRow {
                                        label: "Dunst entfernen";
                                        text: round(root.v-dehaze);
                                        minimum: 0;
                                        maximum: 100;
                                        value <=> root.v-dehaze;
                                        enabled: root.controls-enabled;
                                        field: "dehaze";
                                        edited(f, v) => { root.edited(f, v); }
                                        reset(f) => { root.reset-field(f); keys.focus(); }
                                        released => { keys.focus(); }
                                    }
                                    SliderRow {
                                        label: "Belichtung";
                                        text: (root.v-exposure > 2.5 ? "+" : "") + round(root.v-exposure / 5) / 10 + " EV";
                                        minimum: -100;
                                        maximum: 100;
                                        value <=> root.v-exposure;
                                        enabled: root.controls-enabled;
                                        field: "exposure";
                                        edited(f, v) => { root.edited(f, v); }
                                        reset(f) => { root.reset-field(f); keys.focus(); }
                                        released => { keys.focus(); }
                                    }
                                    SliderRow {
                                        label: "Kontrast";
                                        text: (root.v-contrast > 0.5 ? "+" : "") + round(root.v-contrast);
                                        minimum: -100;
                                        maximum: 100;
                                        value <=> root.v-contrast;
                                        enabled: root.controls-enabled;
                                        field: "contrast";
                                        edited(f, v) => { root.edited(f, v); }
                                        reset(f) => { root.reset-field(f); keys.focus(); }
                                        released => { keys.focus(); }
                                    }
                                    SliderRow {
                                        label: "Lichter";
                                        text: (root.v-highlights > 0.5 ? "+" : "") + round(root.v-highlights);
                                        minimum: -100;
                                        maximum: 100;
                                        value <=> root.v-highlights;
                                        enabled: root.controls-enabled;
                                        field: "highlights";
                                        edited(f, v) => { root.edited(f, v); }
                                        reset(f) => { root.reset-field(f); keys.focus(); }
                                        released => { keys.focus(); }
                                    }
                                    SliderRow {
                                        label: "Tiefen";
                                        text: (root.v-shadows > 0.5 ? "+" : "") + round(root.v-shadows);
                                        minimum: -100;
                                        maximum: 100;
                                        value <=> root.v-shadows;
                                        enabled: root.controls-enabled;
                                        field: "shadows";
                                        edited(f, v) => { root.edited(f, v); }
                                        reset(f) => { root.reset-field(f); keys.focus(); }
                                        released => { keys.focus(); }
                                    }
                                }

                                // Klarheit, Schärfen und Rauschreduzierung kommen mit Phase 10.
                                if root.panel-tab == 2: Text {
                                    text: "Klarheit, Schärfen und Rauschreduzierung folgen in einer der nächsten Versionen.";
                                    wrap: word-wrap;
                                    color: #8a8f98;
                                    font-size: 12px;
                                }
                            }
                        }

                        if root.selected-count > 1 || root.can-undo-transfer: Heading {
                            text: root.selected-count > 1 ? "Mehrere Bilder (" + root.selected-count + ")" : "Mehrere Bilder";
                        }
                        if root.selected-count > 1: Button {
                            text: "Gleiche Werte übernehmen";
                            enabled: root.controls-enabled;
                            clicked => {
                                root.transfer-fixed();
                                keys.focus();
                            }
                        }
                        if root.selected-count > 1: Button {
                            text: "Auto + Abweichung übernehmen";
                            enabled: root.controls-enabled;
                            clicked => {
                                root.transfer-relative();
                                keys.focus();
                            }
                        }
                        if root.can-undo-transfer: Button {
                            text: "Letzte Übernahme rückgängig";
                            clicked => {
                                root.undo-transfer();
                                keys.focus();
                            }
                        }
                        Rectangle {
                            height: 1px;
                            background: #00000060;
                        }
                        if !root.exporting: HorizontalLayout {
                            spacing: 6px;
                            Button {
                                horizontal-stretch: 1;
                                text: "Aktuelles Bild exportieren (Strg+E)";
                                primary: true;
                                enabled: root.current >= 0;
                                clicked => {
                                    root.export-current();
                                    keys.focus();
                                }
                            }
                            // Export-Einstellungen; Dreieck wie bei der Programmauswahl darunter.
                            Rectangle {
                                width: 34px;
                                border-radius: 4px;
                                background: export-menu-touch.has-hover ? #ffffff26 : #ffffff12;
                                Path {
                                    x: (parent.width - 10px) / 2;
                                    y: (parent.height - 10px) / 2;
                                    width: 10px;
                                    height: 10px;
                                    viewbox-width: 10;
                                    viewbox-height: 10;
                                    commands: "M 0 2 L 10 2 L 5 8 Z";
                                    fill: #c8ccd2;
                                    stroke-width: 0px;
                                }
                                export-menu-touch := TouchArea {
                                    clicked => {
                                        export-menu.show();
                                    }
                                }
                                export-menu := PopupWindow {
                                    x: parent.width - 290px;
                                    y: -self.height - 6px;
                                    width: 290px;
                                    height: 150px;
                                    // Der Regler im Menü soll es beim Ziehen nicht schließen.
                                    close-policy: PopupClosePolicy.close-on-click-outside;
                                    Rectangle {
                                        background: #2b2d31;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: #00000080;
                                        VerticalLayout {
                                            padding: 12px;
                                            spacing: 8px;
                                            Heading {
                                                text: "Export-Einstellungen";
                                            }
                                            SliderRow {
                                                label: "JPG-Qualität";
                                                text: round(root.jpeg-quality);
                                                minimum: 50;
                                                maximum: 100;
                                                value <=> root.jpeg-quality;
                                                field: "jpeg-quality";
                                                edited(f, v) => { root.jpeg-quality-changed(v); }
                                                reset(f) => { root.jpeg-quality-changed(95); }
                                            }
                                            Text {
                                                text: "Ziel ist immer der Unterordner „uw-korrigiert“: gleicher Dateiname, EXIF und Farbprofil bleiben.";
                                                wrap: word-wrap;
                                                color: #8a8f98;
                                                font-size: 11px;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if !root.exporting && root.selected-count > 1: Button {
                            text: "Auswahl exportieren, " + root.selected-count + " Bilder (Strg+Umschalt+E)";
                            clicked => {
                                root.export-selection();
                                keys.focus();
                            }
                        }
                        if !root.exporting: HorizontalLayout {
                            spacing: 6px;
                            Button {
                                horizontal-stretch: 1;
                                text: "In " + root.open-with-name + " öffnen";
                                enabled: root.current >= 0;
                                clicked => {
                                    root.open-in-program();
                                    keys.focus();
                                }
                            }
                            // Programmauswahl; Dreieck selbst gezeichnet (siehe Bildinformationen).
                            Rectangle {
                                width: 34px;
                                border-radius: 4px;
                                background: menu-touch.has-hover ? #ffffff26 : #ffffff12;
                                Path {
                                    x: (parent.width - 10px) / 2;
                                    y: (parent.height - 10px) / 2;
                                    width: 10px;
                                    height: 10px;
                                    viewbox-width: 10;
                                    viewbox-height: 10;
                                    commands: "M 0 2 L 10 2 L 5 8 Z";
                                    fill: #c8ccd2;
                                    stroke-width: 0px;
                                }
                                menu-touch := TouchArea {
                                    clicked => {
                                        program-menu.show();
                                    }
                                }
                                program-menu := PopupWindow {
                                    x: parent.width - 290px;
                                    y: -(root.programs.length * 30px + 48px);
                                    width: 290px;
                                    Rectangle {
                                        background: #2b2d31;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: #00000080;
                                        VerticalLayout {
                                            padding: 6px;
                                            for program[i] in root.programs: Rectangle {
                                                height: 30px;
                                                border-radius: 4px;
                                                background: row-touch.has-hover ? #2a7fff33 : transparent;
                                                HorizontalLayout {
                                                    padding-left: 8px;
                                                    padding-right: 8px;
                                                    spacing: 6px;
                                                    Text {
                                                        width: 14px;
                                                        text: program.chosen ? "✓" : "";
                                                        vertical-alignment: center;
                                                        color: #2a7fff;
                                                    }
                                                    Text {
                                                        horizontal-stretch: 1;
                                                        text: program.name;
                                                        vertical-alignment: center;
                                                        color: program.found ? Palette.foreground : #8a8f98;
                                                    }
                                                    if !program.found: Text {
                                                        text: "nicht gefunden – suchen …";
                                                        vertical-alignment: center;
                                                        color: #8a8f98;
                                                        font-size: 11px;
                                                    }
                                                }
                                                row-touch := TouchArea {
                                                    clicked => {
                                                        root.choose-program(i);
                                                        keys.focus();
                                                    }
                                                }
                                            }
                                            Rectangle {
                                                height: 1px;
                                                background: #ffffff20;
                                            }
                                            Rectangle {
                                                height: 30px;
                                                border-radius: 4px;
                                                background: add-touch.has-hover ? #2a7fff33 : transparent;
                                                Text {
                                                    x: 28px;
                                                    text: "Anderes Programm hinzufügen …";
                                                    vertical-alignment: center;
                                                }
                                                add-touch := TouchArea {
                                                    clicked => {
                                                        root.add-program();
                                                        keys.focus();
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if root.exporting: Text {
                            text: root.export-progress;
                            font-size: 12px;
                        }
                        if root.exporting: Button {
                            text: "Export abbrechen";
                            clicked => {
                                root.cancel-export();
                                keys.focus();
                            }
                        }
                        Text {
                            text: root.status;
                            wrap: word-wrap;
                            color: #8a8f98;
                            font-size: 12px;
                        }
                    }
                }
            }

            Rectangle {
                height: 36px;
                background: Palette.alternate-background;

                Rectangle {
                    y: 0;
                    height: 1px;
                    background: #00000060;
                }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 4px;
                    padding-bottom: 4px;
                    spacing: 8px;

                    // Ansicht des Bildes darüber. Gedrückt halten (oder Leertaste): ganzes Bild als Original.
                    before-button := Button {
                        text: "Original";
                        primary: self.pressed || root.space-held;
                        enabled: root.has-preview;
                        clicked => {
                            keys.focus();
                        }
                    }
                    Button {
                        text: "Split-Ansicht";
                        checkable: true;
                        checked <=> root.split;
                        enabled: root.has-preview;
                        clicked => {
                            keys.focus();
                        }
                    }
                    Rectangle {
                        width: 1px;
                        background: #00000060;
                    }

                    Text {
                        text: root.thumbs.length == 0 ? "Kein Ordner geöffnet" : root.folder + "   ·   " + root.thumbs.length + " Bilder";
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        overflow: elide;
                        font-size: 12px;
                    }
                    Text {
                        text: "Leiste zeigt:";
                        vertical-alignment: center;
                        font-size: 12px;
                    }
                    VerticalLayout {
                        alignment: center;
                        Segmented {
                            width: 190px;
                            options: ["Original", "Korrigiert"];
                            selected: root.strip-corrected ? 1 : 0;
                            changed(i) => {
                                root.strip-mode-changed(i == 1);
                                keys.focus();
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 26px;
                            height: 26px;
                            border-radius: 13px;
                            border-width: 1px;
                            border-color: #5a5d65;
                            background: help-touch.has-hover ? #ffffff26 : #ffffff10;
                            Text {
                                text: "?";
                                font-weight: 700;
                            }
                            help-touch := TouchArea {
                                clicked => {
                                    root.show-help = true;
                                    keys.focus();
                                }
                            }
                        }
                    }
                }
            }

            // Bildleiste
            Rectangle {
                height: 150px;
                background: Palette.alternate-background;

                Rectangle {
                    y: 0;
                    height: 1px;
                    background: #00000060;
                }

                HorizontalLayout {
                // „Ordner öffnen“ steht fest am Anfang der Leiste; nur die Bilder daneben scrollen.
                Rectangle {
                    width: root.cell-width + 2 * root.cell-gap;
                    Button {
                        x: root.cell-gap;
                        y: 10px;
                        width: root.cell-width;
                        height: 118px;
                        text: "Ordner öffnen …";
                        primary: root.thumbs.length == 0;
                        clicked => {
                            root.open-folder();
                            keys.focus();
                        }
                    }
                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        background: #00000060;
                    }
                }

                // Slint scrollt eine nur waagerecht scrollbare Liste nicht mit dem senkrechten Mausrad.
                TouchArea {
                    horizontal-stretch: 1;
                    scroll-event(event) => {
                        if event.delta-y == 0px {
                            return reject;
                        }
                        strip.content-x = clamp(
                            strip.content-x + event.delta-y,
                            min(0px, strip.visible-width - strip.content-width),
                            0px);
                        accept
                    }

                    strip := ScrollView {
                        width: 100%;
                        height: 100%;
                        content-width: root.thumbs.length * (root.cell-width + root.cell-gap) + root.cell-gap;
                        content-height: self.visible-height;

                        for thumb[i] in root.thumbs: Rectangle {
                            x: root.cell-gap + i * (root.cell-width + root.cell-gap);
                            y: 10px;
                            width: root.cell-width;
                            height: 118px;
                            border-radius: 6px;
                            border-width: 2px;
                            border-color: i == root.current ? #2a7fff : (thumb.selected ? #7fb0ff90 : transparent);
                            background: i == root.current ? #2a7fff33 : (thumb.selected ? #2a7fff1c : #2b2d31);

                            Image {
                                x: 6px;
                                y: 6px;
                                width: parent.width - 12px;
                                height: 88px;
                                source: root.strip-corrected && thumb.has-corrected ? thumb.corrected : thumb.image;
                                image-fit: contain;
                            }
                            if !thumb.loaded: Text {
                                y: 40px;
                                text: "…";
                                color: #6b7078;
                            }
                            if thumb.exported: Rectangle {
                                x: 10px;
                                y: 74px;
                                width: 18px;
                                height: 18px;
                                border-radius: 9px;
                                background: #2ea043;
                                border-width: 1px;
                                border-color: #141518;
                                Text {
                                    text: "✓";
                                    color: white;
                                    font-size: 11px;
                                    font-weight: 700;
                                }
                            }
                            if thumb.edited: Rectangle {
                                x: parent.width - 18px;
                                y: 10px;
                                width: 10px;
                                height: 10px;
                                border-radius: 5px;
                                background: #f5a623;
                                border-width: 1px;
                                border-color: #141518;
                            }
                            if thumb.failed: Text {
                                y: 40px;
                                text: "nicht lesbar";
                                color: #e5484d;
                                font-size: 11px;
                            }
                            Text {
                                x: 6px;
                                y: 98px;
                                width: parent.width - 12px;
                                text: thumb.name;
                                font-size: 11px;
                                color: #c8ccd2;
                                overflow: elide;
                                horizontal-alignment: center;
                            }
                            TouchArea {
                                pointer-event(event) => {
                                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                        keys.focus();
                                        root.thumb-pressed(i, event.modifiers.control, event.modifiers.shift);
                                    }
                                }
                            }
                        }
                    }
                }
                }
            }
        }

        if root.show-help: Rectangle {
            background: #000000b0;
            TouchArea {
                clicked => {
                    root.show-help = false;
                }
            }
            Rectangle {
                width: min(parent.width - 80px, 760px);
                height: parent.height - 80px;
                border-radius: 8px;
                background: #25262a;
                border-width: 1px;
                border-color: #00000080;
                // Klicks im Hilfefenster schließen es nicht.
                TouchArea { }
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    HorizontalLayout {
                        Text {
                            horizontal-stretch: 1;
                            text: "Hilfe";
                            font-size: 20px;
                            font-weight: 700;
                        }
                        Button {
                            text: "Schließen (Esc)";
                            clicked => {
                                root.show-help = false;
                                keys.focus();
                            }
                        }
                    }
                    help-scroll := ScrollView {
                        vertical-stretch: 1;
                        content-width: self.visible-width;
                        content-height: help-body.preferred-height;
                        help-body := VerticalLayout {
                            width: help-scroll.visible-width - 14px;
                            spacing: 6px;
                            for section in root.help: VerticalLayout {
                                spacing: 4px;
                                padding-bottom: 10px;
                                Heading {
                                    text: section.title;
                                }
                                for line in section.lines: HorizontalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: "•";
                                        color: #8a8f98;
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: line;
                                        wrap: word-wrap;
                                        font-size: 12px;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
