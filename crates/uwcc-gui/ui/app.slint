import { Button, CheckBox, GroupBox, LineEdit, Palette } from "std-widgets.slint";

export struct ValueRow {
    name: string,
    value: string,
}

// Slint kennt keine gestrichelten Ränder; die Striche sind einzelne Rechtecke, so verteilt,
// dass an jeder Ecke ein Strich sitzt.
component DashedBorder inherits Rectangle {
    in property <color> stroke;
    in property <length> dash: 12px;
    in property <length> gap: 7px;
    in property <length> thickness: 2px;
    property <int> nx: max(2, floor((self.width + self.gap) / (self.dash + self.gap)));
    property <int> ny: max(2, floor((self.height + self.gap) / (self.dash + self.gap)));
    property <length> step-x: (self.width - self.dash) / (self.nx - 1);
    property <length> step-y: (self.height - self.dash) / (self.ny - 1);

    for i in root.nx: Rectangle {
        x: i * root.step-x;
        y: 0;
        width: root.dash;
        height: root.thickness;
        background: root.stroke;
    }
    for i in root.nx: Rectangle {
        x: i * root.step-x;
        y: root.height - root.thickness;
        width: root.dash;
        height: root.thickness;
        background: root.stroke;
    }
    for i in root.ny: Rectangle {
        x: 0;
        y: i * root.step-y;
        width: root.thickness;
        height: root.dash;
        background: root.stroke;
    }
    for i in root.ny: Rectangle {
        x: root.width - root.thickness;
        y: i * root.step-y;
        width: root.thickness;
        height: root.dash;
        background: root.stroke;
    }
}

export component AppWindow inherits Window {
    title: "Unterwasser-Farbkorrektur – Analyse";
    preferred-width: 1000px;
    preferred-height: 600px;
    min-width: 780px;
    min-height: 480px;

    in property <bool> has-image;
    in property <bool> busy;
    in property <bool> drag-over;
    in property <image> preview-original;
    in property <image> preview-corrected;
    in property <string> file-name;
    in property <[ValueRow]> values;
    in property <bool> has-values;
    in property <bool> applying;
    in property <string> status;
    in property <bool> status-error;
    in-out property <bool> show-original;
    in-out property <string> port;
    in-out property <string> token-file;

    callback choose-file();
    callback copy-values();
    callback apply-in-photocraft();

    HorizontalLayout {
        padding: 16px;
        spacing: 16px;

        drop-zone := Rectangle {
            horizontal-stretch: 1;
            border-radius: 8px;
            background: root.drag-over ? #2a7fff22 : transparent;

            if !root.has-image: DashedBorder {
                width: 100%;
                height: 100%;
                stroke: root.drag-over ? #2a7fff : #9aa5b1;
            }
            if !root.has-image: VerticalLayout {
                alignment: center;
                spacing: 8px;
                Text {
                    text: "JPG hier hineinziehen";
                    font-size: 24px;
                    horizontal-alignment: center;
                    color: root.drag-over ? #2a7fff : Palette.foreground;
                }
                Text {
                    text: "oder klicken, um ein Bild auszuwählen";
                    font-size: 13px;
                    horizontal-alignment: center;
                    color: #9aa5b1;
                }
            }
            if root.has-image: Image {
                width: 100%;
                height: 100%;
                source: root.show-original ? root.preview-original : root.preview-corrected;
                image-fit: contain;
            }
            if root.has-image && root.drag-over: Rectangle {
                border-radius: 8px;
                border-width: 3px;
                border-color: #2a7fff;
                background: #2a7fff22;
            }
            if root.busy: Rectangle {
                border-radius: 8px;
                background: #000000a0;
                Text {
                    text: "Analysiere …";
                    font-size: 20px;
                    color: white;
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.choose-file();
                }
            }
        }

        VerticalLayout {
            width: 320px;
            spacing: 10px;

            Text {
                text: "Werte";
                font-size: 20px;
                font-weight: 700;
            }
            Text {
                text: root.has-image ? root.file-name : "Noch kein Bild geladen.";
                wrap: word-wrap;
                color: #9aa5b1;
            }
            for row in root.values: HorizontalLayout {
                Text {
                    text: row.name;
                    vertical-alignment: center;
                }
                Text {
                    text: row.value;
                    horizontal-alignment: right;
                    font-family: "Consolas";
                    font-size: 15px;
                    font-weight: 700;
                }
            }
            CheckBox {
                text: "Original zeigen (statt Vorschau der Korrektur)";
                checked <=> root.show-original;
                enabled: root.has-values;
            }
            Button {
                text: "Werte kopieren";
                enabled: root.has-values;
                clicked => {
                    root.copy-values();
                }
            }
            Button {
                text: root.applying ? "Wird angewendet …" : "In PhotoCraft anwenden";
                primary: true;
                enabled: root.has-values && !root.applying;
                clicked => {
                    root.apply-in-photocraft();
                }
            }
            Text {
                text: root.status;
                wrap: word-wrap;
                color: root.status-error ? #e5484d : Palette.foreground;
            }
            Rectangle {
                vertical-stretch: 1;
            }
            GroupBox {
                title: "PhotoCraft-Verbindung";
                vertical-stretch: 0;
                VerticalLayout {
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Port";
                            width: 80px;
                            vertical-alignment: center;
                        }
                        LineEdit {
                            text <=> root.port;
                            input-type: number;
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Token-Datei";
                            width: 80px;
                            vertical-alignment: center;
                        }
                        LineEdit {
                            text <=> root.token-file;
                        }
                    }
                }
            }
        }
    }
}
